@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var userId = Context.Session.GetString("UserId");  // Get the userId from session
}

<div class="container">
    <h2>Lịch sử từ thiện</h2>
    <!-- Search Bar -->
    <div class="blog-single__right-item">
        <div class="item shadow mb-30">
            <h5 class="title">Search</h5>
            <div class="serach-bar">
                <input type="text" id="searchInput" placeholder="Search here" style="padding:6px;">
                @* <button id="searchButton"><i class="fa-regular fa-magnifying-glass"></i></button> *@
            </div>
        </div>
    </div>
    <div class="blog-single__right-item">
        <div class="item shadow mb-30">
            <div class="date-filter">
                <h5 class="title">Filter by Date</h5>
                <input type="date" id="startDate" placeholder="Start Date">
                <input type="date" id="endDate" placeholder="End Date">
                <button id="applyDateFilter">Apply Filter</button>
            </div>
        </div>
    </div>
    <!-- Error Message -->
    <div id="errorMessage" class="alert alert-danger" style="display:none;"></div>

    <!-- Table to display transactions -->
    <table class="table table-bordered table-hover" id="transactions-table" style="display:none;">
        <thead>
            <tr>
                <th scope="col">Mã Giao Dịch</th>
                <th scope="col">Thời Điểm Giao Dịch</th>
                <th scope="col">Số Tiền</th>
                <th scope="col">Nội Dung Giao Dịch</th>
                <th scope="col">Tên Chiến Dịch</th>
            </tr>
        </thead>
        <tbody id="transactionLogs"></tbody>
    </table>

    <!-- Pagination Controls -->
    <div id="paginationControls" class="pegi justify-content-center mt-80 pagination"></div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    $(document).ready(function () {
        // Load transactions on page load
        loadTransactions(1, "", "", "");

        // Event handler for search button click
        $('#searchButton').click(function () {
            var searchInput = $('#searchInput').val();
            loadTransactions(1, searchInput);
        });

        // Event handler for pressing 'Enter' in the search input field
        $('#searchInput').keypress(function (e) {
            if (e.which === 13) {  // Enter key
                var searchInput = $('#searchInput').val();
                loadTransactions(1, searchInput);
            }
        });
        $('#applyDateFilter').click(function () {
            const startDate = $('#startDate').val();
            const endDate = $('#endDate').val();

            if (new Date(startDate) > new Date(endDate)) {
                showError("Start date cannot be later than end date.");
                return;
            }

            const searchInput = $('#searchInput').val();
            loadTransactions(1, searchInput, startDate, endDate);
        });
    });

    // Function to load transactions with pagination and search
    function loadTransactions(currentPage, searchInput,startDate, endDate) {
        var userId = '@userId';  // Get userId from session
        var apiUrl = `https://localhost:7294/api/TransactionLogs/GetUserTransactionLogs/${userId}?searchInput=${searchInput}&currentPage=${currentPage}&startDate=${startDate}&endDate=${endDate}`;

        // Make AJAX call to fetch transactions
        $.ajax({
            url: apiUrl,
            type: 'GET',
            success: function (response) {
                if (response && response.data && response.data.data) {
                    renderTransactionLogs(response.data.data);
                    renderPagination(response.data.dataCount, currentPage, searchInput, startDate, endDate);
                } else {
                    showError("No transaction logs available.");
                }
            },
            error: function () {
                showError("Failed to fetch transaction logs.");
            }
        });
    }

    // Function to render the transaction logs in the table
    function renderTransactionLogs(transactions) {
        $('#transactions-table').show();
        $('#transactionLogs').empty();

        transactions.forEach(function (transaction) {
            const formattedAmount = transaction.amount.toLocaleString('vi-VN', {
                style: 'currency',
                currency: 'VND'
            });
            var rowHtml = `<tr>
                                                                            <td>${transaction.tid}</td>
                                                                            <td>${new Date(transaction.transactionDate).toLocaleString()}</td>
                                                                                <td>${formattedAmount}</td>
                                                                            <td>${transaction.description}</td>
                                                                            <td>${transaction.campaignName}</td>
                                                                        </tr>`;
            $('#transactionLogs').append(rowHtml);
        });

        $('#errorMessage').hide();
    }

