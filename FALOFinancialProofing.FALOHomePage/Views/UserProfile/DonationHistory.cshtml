    function renderPagination(totalRecords, currentPage, searchInput, startDate, endDate) {
        var pageSize = 30;
        var totalPages = Math.ceil(totalRecords / pageSize);
        var paginationControls = $('#paginationControls');
        paginationControls.empty();

        if (totalPages <= 1) return;

        if (currentPage > 1) {
            paginationControls.append(`<button onclick="loadTransactions(${currentPage - 1}, '${searchInput}', '${startDate}', '${endDate}')">
                <i class="fa-solid fa-arrow-left-long primary-color transition"></i>
            </button>`);
        }

        if (totalPages <= 6) {
            for (var i = 1; i <= totalPages; i++) {
                paginationControls.append(generatePageButton(i, currentPage, searchInput, startDate, endDate));
            }
        } else {
            paginationControls.append(generatePageButton(1, currentPage, searchInput, startDate, endDate));
            paginationControls.append(generatePageButton(2, currentPage, searchInput, startDate, endDate));

            if (currentPage > 4) {
                paginationControls.append(`<span>...</span>`);
            }

            var startPage = Math.max(3, currentPage - 1);
            var endPage = Math.min(totalPages - 2, currentPage + 1);

            for (var i = startPage; i <= endPage; i++) {
                paginationControls.append(generatePageButton(i, currentPage, searchInput, startDate, endDate));
            }

            if (currentPage < totalPages - 3) {
                paginationControls.append(`<span>...</span>`);
            }

            paginationControls.append(generatePageButton(totalPages - 1, currentPage, searchInput, startDate, endDate));
            paginationControls.append(generatePageButton(totalPages, currentPage, searchInput, startDate, endDate));
        }

        if (currentPage < totalPages) {
            paginationControls.append(`<button onclick="loadTransactions(${currentPage + 1}, '${searchInput}', '${startDate}', '${endDate}')">
                <i class="fa-solid fa-arrow-right-long primary-color transition"></i>
            </button>`);
        }
    }

    function generatePageButton(page, currentPage, searchInput, startDate, endDate) {
        if (page === currentPage) {
            return `<button class="active" disabled>${page}</button>`;
        } else {
            return `<button onclick="loadTransactions(${page}, '${searchInput}', '${startDate}', '${endDate}')">${page}</button>`;
        }
    }
    // Function to show error message
    function showError(message) {
        $('#errorMessage').text(message).show();
        $('#transactions-table').hide();
    }
</script>
