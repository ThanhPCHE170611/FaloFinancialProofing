﻿@{
    ViewData["Title"] = "ForgotPassword";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Forgot Password</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            position: relative;
            background-image: url('/images/banner/banner_2.jpg');
            background-size: cover;
            background-position: center;
            background-attachment: fixed;
            background-color: #f8f9fa;
            height: 100vh; /* Ensure body takes the full height of the screen */
        }

            /* Add an orange filter layer */
            body::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                bottom: 0;
                background: rgba(255, 69, 0, 0.4);
                z-index: 1;
            }

        .container {
            position: relative;
            z-index: 2;
        }

        .login-card {
            border-radius: 15px;
        }
    </style>
</head>
<body>
    <div class="container d-flex justify-content-center align-items-center vh-100">
        <div class="card login-card p-4 shadow-lg" style="width: 25rem;">
            <h3 class="text-center mb-4">Quên Mật Khẩu</h3>
            <form>
                <div class="mb-3">
                    <label for="email" class="form-label">Email</label>
                    <input type="email" class="form-control" id="email" placeholder="Hãy điền địa chỉ email của bạn" required>
                </div>
                <div class="d-grid">
                    <button type="submit" class="btn btn-primary">Gửi link reset</button>
                </div>
                <div class="text-center mt-3">
                    <hr>
                </div>
                <div class="text-center mt-3">
                    <a asp-area="" asp-controller="Authentication" asp-action="Login" class="btn btn-link">Đăng Nhập</a>
                </div>
            </form>
        </div>
    </div>

</body>
</html>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/authentication/forgotpassword.js"></script>
