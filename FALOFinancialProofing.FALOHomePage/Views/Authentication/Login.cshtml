﻿@{
    ViewData["Title"] = "Login";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="shortcut icon" href="~/images/favicon.png">
    <title>Trang Đăng Nhập</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css?family=Roboto:300,400,500,700,900" rel="stylesheet" />
    <style>
        body {
            position: relative;
            background-image: url('/images/banner/banner_2.jpg');
            background-size: cover;
            background-position: center;
            background-attachment: fixed;
            background-color: #f8f9fa;
            height: 100vh; /* Ensure body takes the full height of the screen */
        }

            /* Add an orange filter layer */
            body::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                bottom: 0;
                background: rgba(255, 69, 0, 0.4);
                z-index: 1;
            }

        .container {
            position: relative;
            z-index: 2; 
        }

        .login-card {
            border-radius: 15px;
        }
    </style>
</head>
<body>
    <div class="container d-flex justify-content-center align-items-center vh-100">
        <div class="card login-card p-4 shadow-lg" style="width: 30rem;">
            <h3 class="text-center mb-4">Đăng Nhập</h3>
            <form method="post" asp-action="Login">
                <div class="mb-3">
                    <label for="username" class="form-label">Tên Người Dùng</label>
                    <input type="text" class="form-control" id="username" name="username" placeholder="Hãy nhập tên người dùng" required>
                </div>
                <div class="mb-3">
                    <label for="password" class="form-label">Mật Khẩu</label>
                    <input type="password" class="form-control" id="password" name="password" placeholder="Hãy nhập mật khẩu" required>
                </div>
                <div class="d-grid">
                    <button type="submit" class="btn btn-primary">Login</button>
                </div>
                <div class="text-center mt-3">
                    <hr>
                    <button type="button" class="btn btn-danger btn-block" onclick="alert('Login with Google')">
                        <i class="fab fa-google"></i> Đăng nhập với Gmail
                    </button>
                </div>
                <div class="text-center mt-3">
                    <a asp-area="" asp-controller="Authentication" asp-action="Register" class="btn btn-link">Đăng ký tài khoản</a>
                </div>
                <div class="text-center mt-3">
                    <a asp-area="" asp-controller="Authentication" asp-action="ForgotPassword">Quên Mật Khẩu?</a>
                </div>
            </form>
            @if (ViewBag.ErrorMessage != null)
            {
                <div id="loginMessage" class="mt-3 text-center text-danger">@ViewBag.ErrorMessage</div>
            }
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
