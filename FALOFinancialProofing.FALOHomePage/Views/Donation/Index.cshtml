@using FALOFinancialProofing.FALOHomePage.Services
@model List<TransactionDetails>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .table {
        margin: 10px auto; /* Space on top and bottom */
        width: 100%; /* Adjust width as needed */
    }

        .table th, .table td {
            padding: 10px; /* Space inside the cells */
        }
</style>

<div class="container">
    <h2>Sao Kê</h2>

    <table class="table table-bordered table-hover" id="transactions-table">
        <thead>
            <tr>
                <th scope="col">Mã Giao Dịch</th>
                <th scope="col">Thời Điểm Giao Dịch</th>
                <th scope="col">Số Tiền</th>
                <th scope="col">Nội Dung Giao Dịch</th>
                <th scope="col">Tài Khoản Giao Dịch</th> 

            </tr>
        </thead>
        <tbody>
            @foreach (var transaction in Model)
            {
                <tr>
                    <td scope="col">@transaction.Reference</td>
                    <td scope="col">@transaction.TransactionDateTime</td>
                    <td scope="col">@transaction.Amount</td>
                    <td scope="col">@transaction.Description</td> 
                    <td scope="col">@transaction.CounterAccountNumber</td>
                </tr>
            }
        </tbody>
    </table>
</div>


<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    // Function to fetch and update transactions
    function fetchTransactions() {
        $.ajax({
            url: '@Url.Action("GetTransactionAsync", "TransactionPollingDirect")', // URL to call
            type: 'GET',
            success: function (data) {
                // Clear the current table
                $('#transactions-table tbody').empty();

                // Populate the table with new data
                data.forEach(function (transaction) {
                    $('#transactions-table tbody').append(
                        `<tr>
                                <td>${transaction.id}</td>
                                <td>${transaction.tid}</td>
                                <td>${transaction.description}</td>
                                <td>${transaction.amount}</td>
                                <td>${new Date(transaction.when).toLocaleString()}</td>
                                <td>${transaction.bankSubAccId}</td>
                            </tr>`
                    );
                });
            },
            error: function (error) {
                console.error("Error fetching transactions:", error);
            }
        });
    }

    // Set up polling every 60 seconds (60000 milliseconds)
    setInterval(fetchTransactions, 60000);
</script>