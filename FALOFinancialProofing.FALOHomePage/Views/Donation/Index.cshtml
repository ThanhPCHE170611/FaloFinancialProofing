@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var campaignId = ViewBag.CampaignId;
}

<style>
    .table {
        margin: 10px auto; /* Space on top and bottom */
        width: 100%; /* Adjust width as needed */
    }

        .table th, .table td {
            padding: 10px; /* Space inside the cells */
        }

    .serach-bar {
        display: flex;
        align-items: center;
        width: 100%; /* You can use a fixed width like 200px for a specific size */
        max-width: 300px; /* Set a max width to ensure it doesn't get too wide */
        margin-top: 10px;
    }

        /* Make the input smaller */
        .serach-bar input[type="text"] {
            width: 70%; /* Adjust width to make it smaller */
            padding: 5px; /* Reduce padding */
            font-size: 14px; /* Adjust font size */
            border: 1px solid #ccc;
            border-radius: 4px;
        }

        /* Make the button smaller */
        .serach-bar button {
            padding: 5px 10px;
            font-size: 14px;
            background-color: #f0f0f0;
            border: 1px solid #ccc;
            border-radius: 4px;
            cursor: pointer;
        }

            .serach-bar button i {
                font-size: 16px; /* Adjust icon size */
            }
</style>

<div class="container">
    <h2>Sao Kê</h2>

    <div class="blog-single__right-item combined-block" style="display: flex; align-items: flex-start;">
        <!-- Search Block (on the left side) -->
        <div class="search-block item shadow mb-30" style="display: flex; flex-direction: column; flex: 1;">
            <h5 class="title">Search</h5>
            <div class="search-bar">
                <input type="text" id="searchInput" placeholder="Search here" style="padding:6px">
            </div>
        </div>

        <!-- Date Filter Block (on the right side) -->
        <div class="date-filter-block item shadow mb-30" style="display: flex; flex-direction: column; flex: 1;">
            <h5 class="title">Filter by Date</h5>
            <div class="date-filter">
                <input type="date" id="startDate" placeholder="Start Date" style="margin-bottom: 5px; border:1px solid black; padding: 3px; border-radius: 8px;">
                <input type="date" id="endDate" placeholder="End Date" style="margin-bottom: 5px; border:1px solid black; padding: 3px; border-radius: 8px;">
                <button id="applyDateFilter">Apply Filter</button>
            </div>
        </div>
    </div>


    <!-- Error Message -->
    <div id="errorMessage" class="alert alert-danger" style="display: none;"></div>

    <!-- Table for Transactions -->
    <div id="transactionsContainer">
        <!-- Data will be populated here using JavaScript -->
    </div>

    <!-- Pagination Controls -->
    <div class="pegi justify-content-center mt-80 pagination" id="paginationContainer" style="margin-top: 40px">
        <!-- Pagination links will be populated here using JavaScript -->
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
<script>
    const campaignId = @campaignId;
    const pageSize = 30;

    let currentPage = 1;
    let totalPages = 1;
    let totalDataCount = 0;
    let fixedTotalAmount = 0;
    var apiUrl = '@Configuration["ApiBaseUrl"]';

    // Function to fetch transaction logs from the API
    function fetchTransactions(page = 1, searchQuery = "", startDate = "", endDate = "") {
        const url = `${apiUrl}/api/TransactionLogs/GetCampaignTransactionLogs/${campaignId}?currentPage=${page}&searchInput=${encodeURIComponent(searchQuery)}&startDate=${startDate}&endDate=${endDate}`; console.log("Fetching URL:", url); // Log the request URL for debugging
        console.log("Fetching URL:", url);
        fetch(url)
            .then(response => response.json())
            .then(data => {
                console.log("API Response:", data); // Log the API response
                if (data?.data?.data) {
                    errorMessage.style.display = 'none';

                    if (fixedTotalAmount === 0) {
                        fixedTotalAmount = data.data.data.reduce((sum, log) => sum + log.amount, 0);
                        displayFixedTotalAmount();
                    }

                    displayTransactions(data.data.data);
                    totalPages = Math.ceil(data.data.dataCount / pageSize);
                    totalDataCount = data.data.dataCount;
                    updatePagination();
                } else {
                    displayError("No transaction logs available.");
                }
            })
            .catch(error => {
                displayError("An error occurred while fetching the data.");
                console.error("Error fetching transaction logs:", error);
            });
    }
    document.getElementById('applyDateFilter').addEventListener('click', applyDateFilter);
    function displayFixedTotalAmount() {
        const totalAmountFormatted = fixedTotalAmount.toLocaleString('vi-VN', {
            style: 'currency',
            currency: 'VND'
        });
        const totalAmountHtml = `
                    <div style="text-align: right; margin-bottom: 10px; font-weight: bold; color: green;">
                        Tổng Số Tiền: ${totalAmountFormatted}
                    </div>`;
        $('#transactionsContainer').before(totalAmountHtml);
    }

    // Function to display transaction logs in the table
    function displayTransactions(transactions) {
        const tableContainer = document.getElementById('transactionsContainer');
        tableContainer.innerHTML = '';  // Clear any existing table content
        if (transactions.length === 0) {
            displayError("No matching transactions found.");
            return;
        }
        const totalAmount = transactions.reduce((sum, log) => sum + log.amount, 0).toLocaleString('vi-VN', {
            style: 'currency',
            currency: 'VND'
        });
        // const totalAmountHtml = `
        //     <div style="text-align: right; margin-bottom: 10px; font-weight: bold; color: green;">
        //         Tổng Số Tiền: ${totalAmount}
        //     </div>`;
        let tableHtml = `
                <table class="table table-bordered table-hover" id="transactions-table">
                                                                                                                                 <thead>
                                                                                                                                     <tr>
                                                                                                                                         <th scope="col">Mã Giao Dịch</th>
                                                                                                                                         <th scope="col">Thời Điểm Giao Dịch</th>
                                                                                                                                         <th scope="col">Số Tiền</th>
                                                                                                                                         <th scope="col">Nội Dung Giao Dịch</th>
                                                                                                                                     </tr>
                                                                                                                                 </thead>
                                                                                                                                 <tbody>`;

        transactions.forEach(log => {
            const formattedAmount = log.amount.toLocaleString('vi-VN', {
                style: 'currency',
                currency: 'VND'
            });

            tableHtml += `<tr>
                                                                                                                                 <td>${log.tid}</td>
                                                                                                                                 <td>${new Date(log.transactionDate).toLocaleString()}</td>
                                                                                                                                     <td>${formattedAmount}</td>
                                                                                                                                 <td>${log.description}</td>
                                                                                                                               </tr>`;
        });

        tableHtml += `</tbody></table>`;
        tableContainer.innerHTML = tableHtml;
    }

    // Function to display error messages
    function displayError(message) {
        const errorMessage = document.getElementById('errorMessage');
        errorMessage.textContent = message;
        errorMessage.style.display = 'block';
    }

    function updatePagination() {
        const paginationContainer = document.getElementById('paginationContainer');
        paginationContainer.innerHTML = '';

        if (currentPage > 1) {
            const prevPageButton = document.createElement('button');
            prevPageButton.innerHTML = `<i class="fa-solid fa-arrow-left-long primary-color transition"></i>`;
            prevPageButton.onclick = () => changePage(currentPage - 1);
            paginationContainer.appendChild(prevPageButton);
        }
        if (totalPages <= 6) {
            for (let page = 1; page <= totalPages; page++) {
                addPageButton(paginationContainer, page);
            }
        } else {
            addPageButton(paginationContainer, 1);
            addPageButton(paginationContainer, 2);
            if (currentPage > 4) {
                const ellipsis = document.createElement('span');
                ellipsis.textContent = '...';
                paginationContainer.appendChild(ellipsis);
            }
            const startPage = Math.max(3, currentPage - 1);
            const endPage = Math.min(totalPages - 2, currentPage + 1);
            for (let page = startPage; page <= endPage; page++) {
                addPageButton(paginationContainer, page);
            }
            if (currentPage < totalPages - 3) {
                const ellipsis = document.createElement('span');
                ellipsis.textContent = '...';
                paginationContainer.appendChild(ellipsis);
            }
            addPageButton(paginationContainer, totalPages - 1);
            addPageButton(paginationContainer, totalPages);
        }

        if (currentPage < totalPages) {
            const nextPageButton = document.createElement('button');
            nextPageButton.innerHTML = `<i class="fa-solid fa-arrow-right-long primary-color transition"></i>`;
            nextPageButton.onclick = () => changePage(currentPage + 1);
            paginationContainer.appendChild(nextPageButton);
        }
    }

    function addPageButton(container, page) {
        const pageButton = document.createElement('button');
        pageButton.textContent = page;
        if (page === currentPage) {
            pageButton.classList.add('active');
            pageButton.disabled = true;
        }
        pageButton.onclick = () => changePage(page);
        container.appendChild(pageButton);
    }

    function changePage(page) {
        if (page >= 1 && page <= totalPages) {
            currentPage = page;
            const searchQuery = document.getElementById('searchInput').value;
            const startDate = document.getElementById('startDate')?.value || "";
            const endDate = document.getElementById('endDate')?.value || "";
            fetchTransactions(currentPage, searchQuery, startDate, endDate);
        }
    }
    function applyDateFilter() {
        const startDate = document.getElementById('startDate').value;
        const endDate = document.getElementById('endDate').value;

        if (new Date(startDate) > new Date(endDate)) {
            displayError("Start date cannot be later than end date.");
            return;
        }

        currentPage = 1;
        fetchTransactions(currentPage, document.getElementById('searchInput').value, startDate, endDate);
    }
    // Listen for Enter key press or click on search button
    document.getElementById('searchInput').addEventListener('keydown', function (e) {
        if (e.key === 'Enter') {
            const searchQuery = e.target.value;
            console.log("Search Query:", searchQuery);
            currentPage = 1;
            fetchTransactions(currentPage, searchQuery);
        }
    });


    // Initial fetch
    fetchTransactions(currentPage);
</script>


