@page "/campaignActivity"
@using static FALOFinancialProofing.FALOHomePage.Models.AttachmentFileDTO

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var attachments = ViewBag.Attachments as List<AttachmentFile>;
    var errorMessage = ViewBag.ErrorMessage as string;
}

<style>
    .table {
        margin: 10px auto; /* Space on top and bottom */
        width: 100%; /* Adjust width as needed */
    }

        .table th, .table td {
            padding: 10px; /* Space inside the cells */
        }
</style>

<div class="container">
    <h2>Hoạt Động</h2>
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger">
            @errorMessage
        </div>
    }

    else if (attachments != null && attachments.Any())
    {
        <div class="blog-single__right-item">
            <div class="item shadow mb-30">
                <h5 class="title">Search</h5>
                <div class="serach-bar">
                    <input type="text" placeholder="Search here">
                    <button><i class="fa-regular fa-magnifying-glass"></i></button>
                </div>
            </div>
        </div>
    <table class="table table-bordered table-hover">
        <thead>
            <tr>
                <th scope="col">Thời Gian</th>
                <th scope="col">Mô tả hoạt động</th>
                <th scope="col">Số tiền</th>
                <th scope="col">Người thực hiện</th>
                <th scope="col">Chứng thực</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var attachment in attachments)
            {
                <tr>
                    <td scope="col">@attachment.CreateAt.ToString("yyyy-MM-dd HH:mm:ss")</td>
                    <td scope="col">@attachment.Description</td>
                    <td scope="col">@attachment.ExpectedMoney</td>
                    <td scope="col">@attachment.CreateByName (@attachment.CreateByEmail)</td>
                        @if (@attachment.AttachmentFilePath != null && @attachment.AttachmentFilePath !="")
                        {
                            <td scope="col"><a href="@attachment.AttachmentFilePath" target="_blank">@attachment.AttachmentFilePath</a></td>
                        }else{
                            <td scope="col" class="text-danger">Thiếu</td>
                        }
                </tr>
            }
        </tbody>
    </table>
    }
    else
    {
    <p>Hiện tại chiến dịch chưa có hoạt động</p>
    }
</div>


<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>