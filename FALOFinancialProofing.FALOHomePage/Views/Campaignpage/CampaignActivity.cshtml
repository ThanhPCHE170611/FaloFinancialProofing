    //     if (currentPage < totalPages) {
    //         paginationControls.append(`<button onclick="loadActivityLogs(${currentPage + 1}, '${searchInput}', ${campaignId})"><i class="fa-solid fa-arrow-right-long primary-color transition"></i></button>`);
    //     }
    // }
    function updatePagination(totalRecords, currentPage, searchInput, campaignId, startDate = "", endDate = "") {
        const pageSize = 30;
        const totalPages = Math.ceil(totalRecords / pageSize);
        const paginationControls = $('#paginationControls');
        paginationControls.empty();

        if (currentPage > 1) {
            paginationControls.append(`<button onclick="loadActivityLogs(${currentPage - 1}, '${searchInput}', ${campaignId}, '${startDate}', '${endDate}')"><i class="fa-solid fa-arrow-left-long primary-color transition"></i></button>`);
        }

        if (totalPages <= 6) {
            for (let i = 1; i <= totalPages; i++) {
                if (i === currentPage) {
                    paginationControls.append(`<button class="active" disabled>${i}</button>`);
                } else {
                    paginationControls.append(`<button onclick="loadActivityLogs(${i}, '${searchInput}', ${campaignId}, '${startDate}', '${endDate}')">${i}</button>`);
                }
            }
        } else {
            paginationControls.append(`<button onclick="loadActivityLogs(1, '${searchInput}', ${campaignId}, '${startDate}', '${endDate}')">1</button>`);
            paginationControls.append(`<button onclick="loadActivityLogs(2, '${searchInput}', ${campaignId}, '${startDate}', '${endDate}')">2</button>`);

            if (currentPage > 4) {
                paginationControls.append(`<span>...</span>`);
            }

            const startPage = Math.max(3, currentPage - 1);
            const endPage = Math.min(totalPages - 2, currentPage + 1);

            for (let i = startPage; i <= endPage; i++) {
                if (i === currentPage) {
                    paginationControls.append(`<button class="active" disabled>${i}</button>`);
                } else {
                    paginationControls.append(`<button onclick="loadActivityLogs(${i}, '${searchInput}', ${campaignId}, '${startDate}', '${endDate}')">${i}</button>`);
                }
            }

            if (currentPage < totalPages - 3) {
                paginationControls.append(`<span>...</span>`);
            }

            paginationControls.append(`<button onclick="loadActivityLogs(${totalPages - 1}, '${searchInput}', ${campaignId}, '${startDate}', '${endDate}')">${totalPages - 1}</button>`);
            paginationControls.append(`<button onclick="loadActivityLogs(${totalPages}, '${searchInput}', ${campaignId}, '${startDate}', '${endDate}')">${totalPages}</button>`);
        }

        if (currentPage < totalPages) {
            paginationControls.append(`<button onclick="loadActivityLogs(${currentPage + 1}, '${searchInput}', ${campaignId}, '${startDate}', '${endDate}')"><i class="fa-solid fa-arrow-right-long primary-color transition"></i></button>`);
        }
    }

    // Function to show error message
    function showError(message) {
        $('#errorMessage').text(message).show();
        $('#activityTable').hide();
    }

    // Function to handle file download
    function downloadAttachmentFile(filePath) {
        const filename = filePath.split('/').pop();
        const url = `https://localhost:7294/api/AttachmentFile/downloadattachmentfilewithnotypebyfilename/${filename}`;

        fetch(url)
            .then(response => {
                if (response.ok) {
                    return response.blob();
                } else {
                    throw new Error('Failed to fetch the file: ' + response.statusText);
                }
            })
            .then(blob => {
                const link = document.createElement('a');
                const blobUrl = URL.createObjectURL(blob);

                link.href = blobUrl;
                link.download = filename;
                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);

                URL.revokeObjectURL(blobUrl);
            })
            .catch(error => {
                console.error('Error downloading file:', error);
                alert('Error downloading file: ' + error.message);
            });
    }
    function applyDateFilter() {
        const startDate = $('#startDate').val();
        const endDate = $('#endDate').val();

        if (new Date(startDate) > new Date(endDate)) {
            showError("Start date cannot be after the end date.");
            return;
        }

        const searchInput = $('#searchInput').val();
        const campaignId = '@ViewBag.campaignId';
        loadActivityLogs(1, searchInput, campaignId, startDate, endDate);
    }
</script>

