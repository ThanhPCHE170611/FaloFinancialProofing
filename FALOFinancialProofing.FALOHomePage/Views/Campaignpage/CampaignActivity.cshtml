@page "/campaignActivity"
@using static FALOFinancialProofing.FALOHomePage.Models.AttachmentFileDTO

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .table {
        margin: 10px auto; /* Space on top and bottom */
        width: 100%; /* Adjust width as needed */
    }

        .table th, .table td {
            padding: 10px; /* Space inside the cells */
        }

    .pagination {
        margin: 20px 0;
        text-align: center;
    }

        .pagination button {
            margin: 0 5px;
        }
</style>

<div class="container">
    <h2>Hoạt Động</h2>
    <!-- Search Bar -->
    <div class="blog-single__right-item">
        <div class="item shadow mb-30">
            <h5 class="title">Search</h5>
            <div class="serach-bar">
                <input type="text" id="searchInput" placeholder="Search here" style=" padding: 6px;">
                @* <button id="searchButton"><i class="fa-regular fa-magnifying-glass"></i></button> *@
            </div>
        </div>
    </div>
    <div class="blog-single__right-item">
        <div class="item shadow mb-30">
            <div class="date-filter">
                <h5 class="title">Filter by Date</h5>
                <input type="date" id="startDate" placeholder="Start Date">
                <input type="date" id="endDate" placeholder="End Date">
                <button id="applyDateFilter">Apply Filter</button>
            </div>
        </div>
    </div>
    <!-- Error Message -->
    <div id="errorMessage" class="alert alert-danger" style="display:none;"></div>

    <!-- Table for displaying the activity logs -->
    <table class="table table-bordered table-hover" id="activityTable" style="display:none;">
        <thead>
            <tr>
                <th scope="col">Thời Gian</th>
                <th scope="col">Mô tả hoạt động</th>
                <th scope="col">Số tiền</th>
                <th scope="col">Người thực hiện</th>
                <th scope="col">Chứng thực</th>
            </tr>
        </thead>
        <tbody id="activityLogs"></tbody>
    </table>

    <!-- Pagination controls -->
    <div id="paginationControls" class="pegi justify-content-center mt-80 pagination"></div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    $(document).ready(function () {
        var campaignId = '@ViewBag.campaignId';
        loadActivityLogs(1, "", campaignId);  // Initial load for page 1

        // Search functionality
        $('#searchButton').click(function () {
            var searchInput = $('#searchInput').val();
            loadActivityLogs(1, searchInput, campaignId);
        });

        // Allow pressing Enter to trigger search
        $('#searchInput').keypress(function (e) {
            if (e.which === 13) {  // Enter key
                var searchInput = $('#searchInput').val();
                loadActivityLogs(1, searchInput, campaignId);
            }
        });
        $('#applyDateFilter').click(applyDateFilter);
    });

    // Function to load activity logs with pagination
    function loadActivityLogs(currentPage, searchInput, campaignId, startDate = "", endDate = "") {
        const apiUrl = `https://localhost:7294/api/AttachmentFile/getallpaymentattachmentincampaignwithrequest/${campaignId}?name=${searchInput}&page=${currentPage}`;

        $.ajax({
            url: apiUrl,
            type: 'GET',
            success: function (response) {
                if (response && response.success && response.data && response.data.data) {
                    renderActivityLogs(response.data.data);
                    // renderPagination(response.data.totalRecords, currentPage, searchInput, campaignId);
                    updatePagination(response.data.totalRecords, currentPage, searchInput, campaignId, startDate, endDate);
                    fetchTotalFiles(campaignId, response.data.data);
                } else {
                    showError("No data found.");
                }
            },
            error: function () {
                showError("Failed to fetch activity logs.");
            }
        });
    }

    // Function to render the activity logs in the table
    function renderActivityLogs(activities) {
        $('#activityTable').show();
        $('#activityLogs').empty();
        fetchTotalMoneyOut();
        activities.forEach(function (activity) {
            const formattedAmount = activity.expectedMoney.toLocaleString('vi-VN', {
                style: 'currency',
                currency: 'VND'
            });
            var rowHtml = `<tr>
                                                                                                        <td>${new Date(activity.createAt).toLocaleString()}</td>
                                                                                                        <td>${activity.description}</td>
                                                                                                            <td>${formattedAmount}</td>
                                                                                                        <td>${activity.createByName} (${activity.createByEmail})</td>
                                                                                                        <td>
                                                                                                            ${activity.attachmentFilePath ?
                    `<a href="javascript:void(0);" onclick="downloadAttachmentFile('${activity.attachmentFilePath}')">${activity.attachmentFilePath}</a>` :
                    '<span class="text-danger">Thiếu</span>'
                }
                                                                                                        </td>
                                                                                                    </tr>`;
            $('#activityLogs').append(rowHtml);
        });

        $('#errorMessage').hide();
    }
    function fetchTotalMoneyOut() {
        const campaignId = '@ViewBag.campaignId';
        const startDate = $('#startDate').val() || "";
        const endDate = $('#endDate').val() || "";
        const searchInput = $('#searchInput').val() || "";

        const apiUrl = `https://localhost:7294/api/TransactionLogs/GetCampaignTransactionLogsMoneyOut/${campaignId}?searchInput=${searchInput}&startDate=${startDate}&endDate=${endDate}`;

    $.ajax({
        url: apiUrl,
        type: 'GET',
        success: function (response) {
            if (response && response.success && response.data && response.data.data) {
                const totalMoneyOut = response.data.data.reduce((sum, transaction) => sum + transaction.amount, 0)
                    .toLocaleString('vi-VN', { style: 'currency', currency: 'VND' });

                $('#activityTable').before(`
                    <div style="text-align: right; margin-bottom: 10px; font-weight: bold; color: red;">
                        Tổng Số Tiền Chi: ${totalMoneyOut}
                    </div>
                `);
            } else {
                console.warn("No data found for total money out.");
            }
        },
        error: function () {
            console.error("Failed to fetch total money out.");
        }
    });
}

    function fetchTotalFiles(campaignId, activities) {
        const apiUrl = `https://localhost:7294/api/AttachmentFile/getnumberallattachmentfileincampain/${campaignId}`;

        $.ajax({
            url: apiUrl,
            type: 'GET',
            success: function (response) {
                if (response && response.success && typeof response.data === 'number') {
                    const totalFiles = response.data; 
                    const currentFiles = activities.filter(activity => activity.attachmentFilePath).length; 
                    const completionPercentage = ((currentFiles / totalFiles) * 100).toFixed(2); 

                    $('#activityTable').before(`
                            <div style="text-align: right; margin-bottom: 10px; font-weight: bold; color: orangered;">
                            Tổng Số File: ${currentFiles} / ${totalFiles} (${completionPercentage}% Hoàn Thành)
                        </div>
                    `);
                } else {
                    console.warn("Failed to fetch total files data.");
                }
            },
            error: function () {
                console.error("Failed to fetch total files.");
            }
        });
    }   

