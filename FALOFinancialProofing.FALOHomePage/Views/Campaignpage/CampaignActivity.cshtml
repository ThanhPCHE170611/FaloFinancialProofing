@page "/campaignActivity"
@using static FALOFinancialProofing.FALOHomePage.Models.AttachmentFileDTO

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .table {
        margin: 10px auto; /* Space on top and bottom */
        width: 100%; /* Adjust width as needed */
    }

        .table th, .table td {
            padding: 10px; /* Space inside the cells */
        }

    .pagination {
        margin: 20px 0;
        text-align: center;
    }

        .pagination button {
            margin: 0 5px;
        }
</style>

<div class="container">
    <h2>Hoạt Động</h2>
    <!-- Search Bar -->
    <div class="blog-single__right-item combined-block" style="display: flex; align-items: flex-start;">
        <!-- Search Block (on the left side) -->
        <div class="search-block item shadow mb-30" style="display: flex; flex-direction: column; flex: 1;">
            <h5 class="title">Search</h5>
            <div class="search-bar">
                <input type="text" id="searchInput" placeholder="Search here" style="padding:6px">
            </div>
        </div>

        <!-- Date Filter Block (on the right side) -->
        <div class="date-filter-block item shadow mb-30" style="display: flex; flex-direction: column; flex: 1;">
            <h5 class="title">Filter by Date</h5>
            <div class="date-filter">
                <input type="date" id="startDate" placeholder="Start Date" style="margin-bottom: 5px; border:1px solid black; padding: 3px; border-radius: 8px;">
                <input type="date" id="endDate" placeholder="End Date" style="margin-bottom: 5px; border:1px solid black; padding: 3px; border-radius: 8px;">
                <button id="applyDateFilter">Apply Filter</button>
            </div>
        </div>
    </div>
    <!-- Error Message -->
    <div id="errorMessage" class="alert alert-danger" style="display:none;"></div>

    <!-- Table for displaying the activity logs -->
    <table class="table table-bordered table-hover" id="activityTable" style="display:none;">
        <thead>
            <tr>
                <th scope="col">Thời Gian</th>
                <th scope="col">Mô tả hoạt động</th>
                <th scope="col">Số tiền</th>
                <th scope="col">Người thực hiện</th>
                <th scope="col">Chứng thực</th>
            </tr>
        </thead>
        <tbody id="activityLogs"></tbody>
    </table>

    <!-- Pagination controls -->
    <div id="paginationControls" class="pegi justify-content-center mt-80 pagination"></div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    @inject Microsoft.Extensions.Configuration.IConfiguration Configuration
    <script>
        let fixedTotalAmount = 0;
        let fixedTotalFiles = 0;
        $(document).ready(function () {
            var campaignId = '@ViewBag.campaignId';
            loadActivityLogs(1, "", campaignId);  // Initial load for page 1
            fetchFixedData(campaignId);

            // Allow pressing Enter to trigger search
            $('#searchInput').keypress(function (e) {
                if (e.which === 13) {  // Enter key
                    var searchInput = $('#searchInput').val();
                    loadActivityLogs(1, searchInput, campaignId);
                }
            });
            $('#applyDateFilter').click(applyDateFilter);
        });

        function formatDateForAPI(date) {
            if (!date) return "";
            const d = new Date(date);
            const month = d.getMonth() + 1;
            const day = d.getDate();
            const year = d.getFullYear();
            return `${month}/${day}/${year}`;
        }

        var apiUrl = '@Configuration["ApiBaseUrl"]';

        // Function to load activity logs with pagination
        function loadActivityLogs(currentPage, searchInput, campaignId, startDate = "", endDate = "") {
            const formattedStartDate = formatDateForAPI(startDate);
            const formattedEndDate = formatDateForAPI(endDate);

            const url = apiUrl + `/api/AttachmentFile/getallpaymentattachmentincampaignwithrequest/${campaignId}?name=${searchInput}&page=${currentPage}&fromdate=${formattedStartDate}&todate=${formattedEndDate}`;

            $.ajax({
                url: url,
                type: 'GET',
                success: function (response) {
                    if (response && response.success && response.data && response.data.data) {
                        renderActivityLogs(response.data.data);
                        updatePagination(response.data.totalRecords, currentPage, searchInput, campaignId, startDate, endDate);
                    } else {
                        showError("No data found.");
                    }
                },
                error: function () {
                    showError("Failed to fetch activity logs.");
                }
            });
        }

        // Function to render the activity logs in the table
        function renderActivityLogs(activities) {
            $('#activityTable').show();
            $('#activityLogs').empty();
            activities.forEach(function (activity) {
                const formattedAmount = activity.expectedMoney.toLocaleString('vi-VN', {
                    style: 'currency',
                    currency: 'VND'
                });
                var rowHtml = `<tr>
                                                                                                                        <td>${new Date(activity.createAt).toLocaleString()}</td>
                                                                                                                        <td>${activity.description}</td>
                                                                                                                            <td>${formattedAmount}</td>
                                                                                                                        <td>${activity.createByName} (${activity.createByEmail})</td>
                                                                                                                        <td>
                                                                                                                            ${activity.attachmentFilePath ?
                        `<a href="javascript:void(0);" onclick="downloadAttachmentFile('${activity.attachmentFilePath}')">${activity.attachmentFilePath}</a>` :
                        '<span class="text-danger">Thiếu</span>'
                    }
                                                                                                                        </td>
                                                                                                                    </tr>`;
                $('#activityLogs').append(rowHtml);
            });
            $('#errorMessage').hide();
        }

        function fetchFixedData(campaignId) {
            const fileApiUrl = apiUrl + `/api/AttachmentFile/getnumberallattachmentfileincampain/${campaignId}`;
            const amountApiUrl = apiUrl + `/api/AttachmentFile/getallpaymentattachmentincampaignwithrequest/${campaignId}`;

            // Fetch total files
            $.ajax({
                url: fileApiUrl,
                type: 'GET',
                success: function (response) {
                    if (response && response.success && typeof response.data === 'number') {
                        fixedTotalFiles = response.data;
                    } else {
                        console.warn("Failed to fetch total file count.");
                    }
                },
                error: function () {
                    console.error("Error fetching total file count.");
                }
            });

            // Fetch total amount
            $.ajax({
                url: amountApiUrl,
                type: 'GET',
                success: function (response) {
                    if (response && response.success && response.data && response.data.data) {
                        fixedTotalAmount = response.data.data.reduce((sum, transaction) => sum + (transaction.expectedMoney || 0), 0);
                        fixedTotalFiles = response.data.totalRecords;
                        displayFixedData(response.data.data);
                    } else {
                        console.warn("Failed to fetch total amount.");
                    }
                },
                error: function () {
                    console.error("Error fetching total amount.");
                }
            });
        }
        function displayFixedData(activities) {
            const currentFiles = activities.filter(activity => activity.attachmentFilePath).length;;
            const completionPercentage = ((currentFiles / fixedTotalFiles) * 100).toFixed(2);
            const totalAmountFormatted = fixedTotalAmount.toLocaleString('vi-VN', {
                style: 'currency',
                currency: 'VND'
            });

            $('#activityTable').before(`
                            <div style="text-align: right; margin-bottom: 10px; font-weight: bold; color: green;">
                                Tổng Số Tiền: ${totalAmountFormatted}
                            </div>
                            <div style="text-align: right; margin-bottom: 10px; font-weight: bold; color: orangered;">
                                Tổng Số File: ${currentFiles} / ${fixedTotalFiles} (${completionPercentage}% Hoàn Thành)
                            </div>
                        `);
        }
        function updatePagination(totalRecords, currentPage, searchInput, campaignId, startDate = "", endDate = "") {
            const pageSize = 30;
            const totalPages = Math.ceil(totalRecords / pageSize);
            const paginationControls = $('#paginationControls');
            paginationControls.empty();

            if (currentPage > 1) {
                paginationControls.append(`<button onclick="loadActivityLogs(${currentPage - 1}, '${searchInput}', ${campaignId}, '${startDate}', '${endDate}')"><i class="fa-solid fa-arrow-left-long primary-color transition"></i></button>`);
            }

            if (totalPages <= 6) {
                for (let i = 1; i <= totalPages; i++) {
                    if (i === currentPage) {
                        paginationControls.append(`<button class="active" disabled>${i}</button>`);
                    } else {
                        paginationControls.append(`<button onclick="loadActivityLogs(${i}, '${searchInput}', ${campaignId}, '${startDate}', '${endDate}')">${i}</button>`);
                    }
                }
            } else {
                paginationControls.append(`<button onclick="loadActivityLogs(1, '${searchInput}', ${campaignId}, '${startDate}', '${endDate}')">1</button>`);
                paginationControls.append(`<button onclick="loadActivityLogs(2, '${searchInput}', ${campaignId}, '${startDate}', '${endDate}')">2</button>`);

                if (currentPage > 4) {
                    paginationControls.append(`<span>...</span>`);
                }

                const startPage = Math.max(3, currentPage - 1);
                const endPage = Math.min(totalPages - 2, currentPage + 1);

                for (let i = startPage; i <= endPage; i++) {
                    if (i === currentPage) {
                        paginationControls.append(`<button class="active" disabled>${i}</button>`);
                    } else {
                        paginationControls.append(`<button onclick="loadActivityLogs(${i}, '${searchInput}', ${campaignId}, '${startDate}', '${endDate}')">${i}</button>`);
                    }
                }

                if (currentPage < totalPages - 3) {
                    paginationControls.append(`<span>...</span>`);
                }

                paginationControls.append(`<button onclick="loadActivityLogs(${totalPages - 1}, '${searchInput}', ${campaignId}, '${startDate}', '${endDate}')">${totalPages - 1}</button>`);
                paginationControls.append(`<button onclick="loadActivityLogs(${totalPages}, '${searchInput}', ${campaignId}, '${startDate}', '${endDate}')">${totalPages}</button>`);
            }

            if (currentPage < totalPages) {
                paginationControls.append(`<button onclick="loadActivityLogs(${currentPage + 1}, '${searchInput}', ${campaignId}, '${startDate}', '${endDate}')"><i class="fa-solid fa-arrow-right-long primary-color transition"></i></button>`);
            }
        }

        // Function to show error message
        function showError(message) {
            $('#errorMessage').text(message).show();
            $('#activityTable').hide();
        }

        // Function to handle file download
        function downloadAttachmentFile(filePath) {
            const filename = filePath.split('/').pop();
            const url = apiUrl + `/api/AttachmentFile/downloadattachmentfilewithnotypebyfilename/${filename}`;

            fetch(url)
                .then(response => {
                    if (response.ok) {
                        return response.blob();
                    } else {
                        throw new Error('Failed to fetch the file: ' + response.statusText);
                    }
                })
                .then(blob => {
                    const link = document.createElement('a');
                    const blobUrl = URL.createObjectURL(blob);

                    link.href = blobUrl;
                    link.download = filename;
                    document.body.appendChild(link);
                    link.click();
                    document.body.removeChild(link);

                    URL.revokeObjectURL(blobUrl);
                })
                .catch(error => {
                    console.error('Error downloading file:', error);
                    alert('Error downloading file: ' + error.message);
                });
        }
        function applyDateFilter() {
            const startDate = $('#startDate').val();
            const endDate = $('#endDate').val();

            if (new Date(startDate) > new Date(endDate)) {
                showError("Start date cannot be after the end date.");
                return;
            }

            const searchInput = $('#searchInput').val();
            const campaignId = '@ViewBag.campaignId';
            loadActivityLogs(1, searchInput, campaignId, startDate, endDate);
        }
    </script>

