@page "/CampaignDetails"

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var campaignDetails = ViewBag.CampaignDetails as FALOFinancialProofing.FALOHomePage.Models.CampaignDetailsDTO;
    var percentage = (campaignDetails.TotalMoneyEarned / campaignDetails.FundTarget) * 100;
}

<main>
    <!-- Page banner area start here -->
    <section class="banner__inner-page bg-image pt-160 pb-160 bg-image"
             data-background="/images/banner/banner_2.jpg">
        <div class="container">
            <h2 class="wow fadeInUp" data-wow-delay="00ms" data-wow-duration="1500ms">Thông Tin Chiến Dịch</h2>
            <div class="breadcrumb-list wow fadeInUp" data-wow-delay="200ms" data-wow-duration="1500ms">
                <a href="@Url.Action("Index", "Homepage")">Home</a><span>
                    <i class="fa-regular fa-angles-right mx-2"></i>Chiến Dịch
                </span>
            </div>
        </div>
    </section>
    <!-- Page banner area end here -->
    <!-- Blog single area start here -->
    <section class="blog-single-area pt-120 pb-120">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-8 order-2 order-lg-1">
                    <div class="blog__item blog-single__left-item shadow-none">
                        <div class="image">
                            <img src="/images/cause/CampaignImages.jpg" alt="image">
                        </div>
                        <div class="progress-area px-4 pb-4 pt-35 bor border-top-0">
                            <div class="progress__item">
                                <div class="progress__content" style="width: @percentage%;"><span>@percentage</span></div>
                            </div>
                            <div class="progress__goal mt-15">
                                <h6>Goal : <span>@campaignDetails.FundTarget</span></h6>
                                <h6>Raised : <span>@campaignDetails.TotalMoneyEarned</span></h6>
                            </div>
                        </div>
                        <div class="blog__content p-0">
                            <h4 class="mt-20 mb-20 fs-30">
                                @campaignDetails.Title
                            </h4>
                            <p class="mb-20 mt-20">
                                @campaignDetails.Description
                            </p>
                        </div>
                    </div>
                </div>
                <div class="col-lg-4 order-1 order-lg-2">
                    <div class="blog-single__right-item">
                        <div class="item shadow mb-30">
                            <h5 class="title">Đóng Góp</h5>
                            <div class="btn-two d-none d-lg-inline-block">
                                <span class=" btn-circle">
                                </span>
                                <a asp-controller="Donation" asp-action="CreateQR" asp-route-campaignId="@campaignDetails.CampaignId" spot class="btn-inner">
                                    <span class="btn-text">
                                        Ủng Hộ
                                    </span>
                                </a>
                            </div>
                        </div>
                        <div class="item shadow mb-30">
                            <h5 class="title">Chứng Thực</h5>
                            <ul class="category">
                                <li><a href="@Url.Action("DownloadAccountingBooks", "Donation", new {id=campaignDetails.CampaignId})">Báo Cáo Tài Chính</a></li>
                                <li><a href="@Url.Action("Index", "Donation", new {id=campaignDetails.BankId})">Sao Kê</a></li>
                                <li><a href="@Url.Action("CampaignActivity", "Campaignpage", new {id=campaignDetails.BankId})">Hoạt Động</a></li>
                            </ul>
                        </div>
                        <div class="item shadow mb-30">
                            <h5 class="title">Thông Tin Cập Nhật</h5>
                            <ul class="category">
                                <li>Báo Cáo Tài Chính</li>
                                <li>Sao Kê</li>
                                <li>Hoạt Động</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!-- Blog single area end here -->
</main>