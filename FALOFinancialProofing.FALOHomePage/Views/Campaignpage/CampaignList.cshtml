@page "/campaignlist"

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<main>
    <!-- Page banner area start here -->
    <section class="banner__inner-page bg-image pt-160 pb-160 bg-image"
             data-background="/images/banner/banner_2.jpg">
        <div class="container">
            <h2 class="wow fadeInUp" data-wow-delay="00ms" data-wow-duration="1500ms">Danh Sách Chiến Dịch</h2>
            <div class="breadcrumb-list wow fadeInUp" data-wow-delay="200ms" data-wow-duration="1500ms">
                <a href="index.html">Home</a><span>
                    <i class="fa-regular fa-angles-right mx-2"></i>Chiến Dịch
                </span>
            </div>
        </div>
    </section>
    <!-- Page banner area end here -->
    <!-- Blog single area start here -->
    <section class="cause-list-area pt-120 pb-120">
        <div class="container">
            <div class="row g-4" id="campaignsContainer">
             </div>
            <div class="pegi justify-content-center mt-80 pagination" id="paginationControls">
            </div>
        </div>
    </section>
    <!-- Blog single area end here -->
</main>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    $(document).ready(function () {
        loadCampaigns();
    });

    $(document).ready(function () {
        loadProjects();
    });



    // Function to load campaigns with pagination
    function loadCampaigns() {
        $.ajax({
            url: `https://localhost:7294/api/Campaign/GetAllCampaignInSystem?status=Fundraising&IsActive=true&currentPage=${pageNumber}`,  // Adjust URL if necessary, e.g., for a specific controller
            type: 'GET',
            data: {
                status: null,  // You can set the status filter if needed
            },
            success: function (response) {
                if (response.success) {
                    renderCampaigns(response.data);
                } else {
                    alert(response.message);
                }
            },
            error: function (error) {
                console.error("Error loading campaigns:", error);
            }
        });
    }

    // Function to render the campaigns data as cards
    function renderCampaigns(data) {
        var campaignsContainer = $('#campaignsContainer');
        campaignsContainer.empty();  // Clear existing data

        data.data.forEach(function (campaign) {
            var date = new Date(campaign.dateOfCreation);

            // Format the date as "Jan 1, 2024"
            var formattedDate = date.toLocaleDateString('en-US', {
                month: 'short',  // "Jan"
                day: 'numeric',  // "1"
                year: 'numeric'  // "2024"
            });

            var percentage = (campaign.totalMoneyEarned / campaign.fundTarget )*100

            var url = '/Campaignpage/Index/' + campaign.campaignId;

            var cardHtml = `<div class="col-lg-8 order-2 order-lg-1" >
                        <div class="cause__item cause-list__item mb-30">
                            <div class="cause__image image" style="width:100%; height:auto;overflow:hidden;">
                                <img src="/images/cause/CampaignImages.jpg" style="width:100%; height:auto;object-fit:cover" alt="image">
                                <span class="cause-tag">${formattedDate}</span>
                            </div>
                            <div class="cause__content">
                                <h4 class="mb-2">
                                    <a href="${url}" class="btn-inner">
                                         ${campaign.title}
                                    </a>
                                </h4>
                                <p class="mb-3">
                                    ${campaign.description}
                                </p>
                                <div class="progress-area">
                                    <div class="progress__item">
                                        <div class="progress__content" style="width: ${percentage}%;"><span>${percentage}%</span></div>
                                    </div>
                                    <div class="progress__goal mt-15">
                                            <h6>Goal : <span>${campaign.fundTarget} VND</span></h6>
                                            <h6>Raised : <span>${campaign.totalMoneyEarned} VND</span></h6>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    `;
            campaignsContainer.append(cardHtml);
        });
    }



    // Function to load projects with pagination
    function loadProjects(pageNumber = 1) {
        $.ajax({
            url: `https://localhost:7294/api/Projects/GetAllProjectInSystem?status=Running&currentPage=${pageNumber}`,  // Adjust URL if necessary, e.g., for a specific controller
            type: 'GET',
            data: {
                status: null,  // You can set the status filter if needed
                currentPage: pageNumber
            },
            success: function (response) {
                if (response.success) {
                    renderProjects(response.data);
                    renderPagination(response.data.dataCount, pageNumber);
                } else {
                    alert(response.message);
                }
            },
            error: function (error) {
                console.error("Error loading projects:", error);
            }
        });
    }

    // Function to render the projects data as cards
    function renderProjects(data) {
        var projectsContainer = $('#projectsContainer');
        projectsContainer.empty();  // Clear existing data

        data.data.forEach(function (project) {
            var date = new Date(project.dateOfCreation);

            // Format the date as "Jan 1, 2024"
            var formattedDate = date.toLocaleDateString('en-US', {
                month: 'short',  // "Jan"
                day: 'numeric',  // "1"
                year: 'numeric'  // "2024"
            });

            var url = '/Projectpage/Index/' + project.id;

            var cardHtml = `<div class="col-xl-4 col-md-6 wow fadeInUp" data-wow-delay="200ms" data-wow-duration="1500ms">
                                <div class="event__inner-item">
                                    <div class="image">
                                        <img src="/images/event/Project_image.jpg" alt="image">
                                                <span class="blog-tag">${formattedDate || 'Date'}</span>
                                    </div>
                                    <div class="blog__content pt-4">
                                        <ul>
                                            <li>
                                               <svg width="20" height="20" viewBox="0 0 20 20" fill="none"
                                                     xmlns="http://www.w3.org/2000/svg">
                                                    <path d="M14.5435 5.19275C14.5435 7.69093 12.4989 9.7355 10.0008 9.7355C7.50262 9.7355 5.45804 7.69093 5.45804 5.19275C5.45804 2.69457 7.50258 0.65 10.0008 0.65C12.4989 0.65 14.5435 2.69458 14.5435 5.19275Z"
                                                          stroke="#F74F22" stroke-width="1.3" />
                                                    <path d="M18.2644 14.6706C18.1052 14.9458 17.9241 15.2073 17.7169 15.4766L17.7168 15.4765L17.7089 15.4873C17.4203 15.8788 17.0845 16.2373 16.7294 16.5924C16.4326 16.8892 16.0932 17.186 15.7567 17.4385C14.0794 18.6911 12.0621 19.3499 9.97814 19.3499C7.89836 19.3499 5.88506 18.6938 4.20976 17.4461C3.84588 17.1504 3.51367 16.8792 3.22686 16.5924L3.2199 16.5854L3.21272 16.5787C2.85663 16.2436 2.54238 15.8877 2.24745 15.4874L2.24747 15.4873L2.24414 15.4829C2.06192 15.24 1.8732 14.9756 1.71919 14.7169C1.83618 14.4559 1.98455 14.1847 2.14521 13.9526L2.14533 13.9527L2.15284 13.9413C3.06984 12.5556 4.53705 11.6388 6.16642 11.4148L6.186 11.4121L6.20538 11.4082C6.23087 11.4031 6.29494 11.4117 6.34548 11.4496L6.34546 11.4496L6.34947 11.4525C7.41651 12.2401 8.68629 12.6453 10.0008 12.6453C11.3153 12.6453 12.5851 12.2401 13.6521 11.4525L13.6521 11.4525L13.6561 11.4496C13.6715 11.438 13.7403 11.408 13.8492 11.4167C15.4688 11.6435 16.9121 12.5568 17.8524 13.9468L17.8524 13.9469L17.8564 13.9526C18.0165 14.1839 18.1557 14.4231 18.2644 14.6706Z"
                                                          stroke="#F74F22" stroke-width="1.3" />
                                                </svg>
                                                <a href="${url}">
                                                    <span class="primary-hover transition">${project.firstName} ${project.lastName}</span>
                                                </a>
                                            </li>
                                        </ul>
                                        <h4 class="mt-15 mb-15">
                                                <a href="${url}">${project.projectName || 'Project Title'}</a>
                                        </h4>
                                        <p>${project.description || 'No description available.'}</p>
                                            <a class="mt-4 read-more fw-bold transition" href="${url}">
                                            EXPLORE MORE <i class="fa-solid fa-arrow-right ms-1"></i>
                                        </a>
                                    </div>
                                </div>
                            </div>
                    `;
            projectsContainer.append(cardHtml);
        });
    }

    
</script>