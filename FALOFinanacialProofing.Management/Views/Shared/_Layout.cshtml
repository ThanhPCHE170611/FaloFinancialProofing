<script>
    document.addEventListener('DOMContentLoaded', function () {
        const jwtToken = localStorage.getItem('jwtToken');
        const checkrole = localStorage.getItem('loggingRole');
        const fullname = localStorage.getItem('fullname');

        var win = navigator.platform.indexOf('Win') > -1;
        if (win && document.querySelector('#sidenav-scrollbar')) {
            var options = {
                damping: '0.5'
            }
            Scrollbar.init(document.querySelector('#sidenav-scrollbar'), options);
        }
        const userRoleElement = document.querySelector('.nav-item.d-flex.align-items-center .nav-link .d-sm-inline');
        if (userRoleElement) {
            const roleIcon = document.createElement('span');
            roleIcon.classList.add('badge', 'bg-secondary', 'ms-2');
            roleIcon.textContent = checkrole;
            userRoleElement.textContent = fullname;
            userRoleElement.appendChild(roleIcon);
        }

        if (checkrole === 'Admin') {
            document.getElementById('adminTabTitle').style.display = 'block';
            document.getElementById('adminTab').style.display = 'block';
            }


        if (checkrole !== "Project Manager" && checkrole !== "Project Management Board") {
            document.getElementById('projectRegistration').style.display = 'none';
            document.getElementById('campaignUpdateProcess').style.display = 'none';
            document.getElementById('campaignRegistration').style.display = 'none';
            document.getElementById('organization').style.display = 'none';
        }
    });
</script>
