@{
    ViewData["Title"] = "CampaignManagement";
}
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <link rel="stylesheet" type="text/css" href="https://fonts.googleapis.com/css?family=Roboto:300,400,500,700,900|Roboto+Slab:400,700" />
    <link href="../assets/css/nucleo-icons.css" rel="stylesheet" />
    <link href="../assets/css/nucleo-svg.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons+Round" rel="stylesheet">
    <link id="pagestyle" href="../assets/css/material-dashboard.css?v=3.1.0" rel="stylesheet" />
    <style>
        .search-filter-container {
            display: flex;
            justify-content: space-between;
            margin: 20px 0;
        }

        .search-box {
            width: 70%;
            padding: 10px;
            border-radius: 5px;
            border: 1px solid #ddd;
        }

        .filter-box {
            width: 25%;
            padding: 10px;
            border-radius: 5px;
            border: 1px solid #ddd;
        }

    </style>
</head>

<body>
    <div class="container-fluid py-4">
        <div class="row">
            <div class="col-12">
                <div class="card my-4">
                    <div class="card-header p-0 position-relative mt-n4 mx-3 z-index-2">
                        <div class="bg-gradient-primary shadow-primary border-radius-lg pt-4 pb-3 d-flex justify-content-between align-items-center">
                            <h6 class="text-white text-capitalize ps-3 mb-0">List Campaign</h6>
                            @* <a class="btn btn-dark mb-0 me-3" asp-controller="Campaign" asp-action="CampaignCreate">
                                Add Campaign
                            </a> *@
                        </div>
                    </div>
                    <div class="search-filter-container px-3">
                        <input type="text" id="searchInput" placeholder="Search by Campaign Name" class="search-box" onkeyup="searchCampaign()" />
                        <select id="statusFilter" class="filter-box" onchange="filterByStatus()">
                            <option value="">All Stages</option>
                            <option value="Fund-Raising">Fund-Raising</option>
                            <option value="Implement">Implement</option>
                            <option value="Disbursement">Disbursement</option>
                            <option value="Close">Close</option>
                        </select>
                        <select id="statusFilterStatus" class="filter-box" onchange="filterByStatus()" style="display:none;">
                            <option value="">All Statuses</option>
                            <option value="true">Active</option>
                            <option value="false">Inactive</option>
                        </select>
                    </div>

                    <div class="card-body px-0 pb-2">
                        <div class="table-responsive p-0">
                            <table class="table align-items-center mb-0" id="campaignTable">
                                <thead class="text-center">
                                    <tr>
                                        <th class="text-uppercase text-secondary text-xs opacity-7">STT</th>
                                        <th class="text-uppercase text-secondary text-xs opacity-7">Campaign Name</th>
                                        <th class="text-uppercase text-secondary text-xs opacity-7">Project Name</th>
                                        <th class="text-uppercase text-secondary text-xs opacity-7">Fund Target</th>
                                        <th class="text-uppercase text-secondary text-xs opacity-7">Stage</th>
                                        <th class="text-uppercase text-secondary text-xs opacity-7">Actions</th>
                                    </tr>
                                </thead>
                                <tbody class="text-center">
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="pagination-container text-center mt-4">
                    <div id="pagination"></div>
                </div>
            </div>
        </div>

    </div>
</body>
</html>

<script src="../assets/js/core/popper.min.js"></script>
<script src="../assets/js/core/bootstrap.min.js"></script>
<script src="../assets/js/plugins/perfect-scrollbar.min.js"></script>
<script src="../assets/js/plugins/smooth-scrollbar.min.js"></script>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script async defer src="https://buttons.github.io/buttons.js"></script>
<script src="../assets/js/material-dashboard.min.js?v=3.1.0"></script>
<script src="~/js/campaign/campaignmanagement.js"></script>