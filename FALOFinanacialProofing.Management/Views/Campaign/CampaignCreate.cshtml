@{
    ViewData["Title"] = "CampaignCreate";
}
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <link rel="stylesheet" type="text/css" href="https://fonts.googleapis.com/css?family=Roboto:300,400,500,700,900|Roboto+Slab:400,700" />
    <link href="../assets/css/nucleo-icons.css" rel="stylesheet" />
    <link href="../assets/css/nucleo-svg.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons+Round" rel="stylesheet">
    <link id="pagestyle" href="../assets/css/material-dashboard.css?v=3.1.0" rel="stylesheet" />
    <link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet">
    <style>
        .form-control {
            border: 1px solid #ced4da;
            border-radius: 0.25rem;
        }

        #save-btn {
            display: flex;
            justify-content: center;
            margin-top: 20px;
        }

        #fileList {
            margin-top: 10px;
            display: flex;
            flex-wrap: wrap;
            gap: 5px;
        }

            #fileList li {
                padding: 5px 10px;
                background-color: #e0e0e0;
                border-radius: 5px;
                list-style: none;
            }

        #imagePreview img {
            width: 100%;
            height: auto;
        }
    </style>
</head>

<body>
    <div class="container-fluid py-4">

        <div class="row">
            <div class="col-12">
                <div class="card my-4">
                    <div class="card-header p-0 position-relative mt-n4 mx-3 z-index-2">
                        <div class="bg-gradient-primary shadow-primary border-radius-lg pt-4 pb-3 d-flex justify-content-between align-items-center">
                            <h6 class="text-white text-capitalize ps-3 mb-0">Create Campaign Registration Request</h6>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label for="campaignName" class="form-label">Campaign Name</label>
                            <input type="text" class="form-control" id="campaignName" placeholder="Enter campaign name">
                        </div>

                        <div class="mb-3">
                            <label for="location" class="form-label">Location</label>
                            <textarea class="form-control" id="location" rows="2" placeholder="Enter campaign location"></textarea>
                        </div>

                        <div class="mb-3">
                            <label for="totalAmount" class="form-label">Fund Target</label>
                            <input type="text" class="form-control" id="totalAmount" placeholder="Enter total amount">
                        </div>

                        <div class="mb-3">
                            <label for="endDate" class="form-label">Expected End Date</label>
                            <input type="date" class="form-control" id="endDate">
                        </div>

                        <div class="mb-3">
                            <label for="projectDescription" class="form-label">Campaign Description</label>
                            <div id="editor-container" style="height: 200px;"></div>
                        </div>
                    </div>
                </div>
                <div class="card mb-4">
                    <div class="card-header">
                        <h5>File Include</h5>
                    </div>
                    <div class="mb-3">
                        <label for="attachments" class="form-label">Attachments</label>
                        <input type="file" class="form-control" id="attachments" multiple>
                        <ul id="fileList">
                        </ul>
                    </div>
                </div>
                <div class="card mb-4">
                    <div class="card-header">
                        <h5>Campaign Picture</h5>
                    </div>
                    <div class="card-body">
                        <button class="btn btn-primary mb-3" onclick="document.getElementById('projectImages').click()">Choose file</button>
                        <input type="file" id="projectImages" class="form-control d-none" accept="image/*" multiple>
                        <div id="imagePreview" class="mt-3 row"></div>
                    </div>
                </div>
                <div id="save-btn">
                    <button class="btn btn-warning btn-lg" style="margin-left:10px">Create</button>
                    <div>
                        <a href="/Project/ProjectManagement" class="btn btn-success btn-lg" style="margin-left:10px">Cancel</a>
                    </div>
                </div>
            </div>
        </div>

    </div>


</body>

</html>

<script src="../assets/js/core/popper.min.js"></script>
<script src="../assets/js/core/bootstrap.min.js"></script>
<script src="../assets/js/plugins/perfect-scrollbar.min.js"></script>
<script src="../assets/js/plugins/smooth-scrollbar.min.js"></script>
<script async defer src="https://buttons.github.io/buttons.js"></script>
<script src="../assets/js/material-dashboard.min.js?v=3.1.0"></script>
<script src="https://cdn.quilljs.com/1.3.6/quill.js"></script>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    var quill = new Quill('#editor-container', {
        theme: 'snow'
    });
    const jwtToken = localStorage.getItem('jwtToken');
    if (!jwtToken) {
        window.location.href = '/Authentication/Login';
        return;
    }
    document.getElementById('attachments').addEventListener('change', function (e) {
        const fileList = document.getElementById('fileList');
        fileList.innerHTML = '';
        Array.from(e.target.files).forEach(file => {
            const li = document.createElement('li');
            const a = document.createElement('a');
            a.href = URL.createObjectURL(file);
            a.textContent = file.name;
            a.download = file.name;
            li.appendChild(a);
            fileList.appendChild(li);
        });
    });
    function formatDateToMMDDYYYY(dateStr) {
        const date = new Date(dateStr);
        const year = date.getFullYear();
        const month = String(date.getMonth() + 1).padStart(2, '0');
        const day = String(date.getDate()).padStart(2, '0');
        const hours = String(date.getHours()).padStart(2, '0');
        const minutes = String(date.getMinutes()).padStart(2, '0');
        const seconds = String(date.getSeconds()).padStart(2, '0');
        return `${year}-${month}-${day}T${hours}:${minutes}:${seconds}`;
    }
    document.getElementById('projectImages').addEventListener('change', function(event) {
      const imagePreview = document.getElementById('imagePreview');
      imagePreview.innerHTML = '';
      const files = event.target.files;
      Array.from(files).forEach(file => {
        const reader = new FileReader();
        reader.onload = function(e) {
          const colDiv = document.createElement('div');
          colDiv.classList.add('col-md-4', 'mb-3');
          const img = document.createElement('img');
          img.src = e.target.result;
          img.classList.add('img-fluid', 'rounded');
          colDiv.appendChild(img);
          imagePreview.appendChild(colDiv);
        }
        reader.readAsDataURL(file);
      });
    });
    $(document).ready(function () {
        $('#totalAmount').on('input', function () {
            let input = $(this).val();

            input = input.replace(/[^0-9]/g, '');

            if (!/^\d+$/.test(input)) {
                alert('Vui lòng nhập số nguyên dương và không chứa dấu thập phân hoặc ký tự không hợp lệ.');
                $(this).val('');
                return;
            }

            const formatted = Number(input).toLocaleString();
            $(this).val(formatted);
        });
        $('#save-btn button').on('click', function (e) {
            e.preventDefault();
            const userId = localStorage.getItem('userId');
            const projectId = new URLSearchParams(window.location.search).get('projectId');

            console.log(projectId);

            const campaignName = $('#campaignName').val();
            const location = $('#location').val();

            // const totalAmount = parseFloat($('#totalAmount').val());
            const totalAmount = $('#totalAmount').val().replace(/,/g, '');

            let endDate = $('#endDate').val();
            const description = quill.getText();;
            const files = $('#attachments')[0].files;

            const today = new Date();
            today.setHours(0, 0, 0, 0); 
            const selectedEndDate = new Date(endDate);

            if (!campaignName || !totalAmount || !endDate) {
                alert('Please fill in all required fields.');
                return;
            }
            if (!campaignName || campaignName.length < 8) {
                alert('Campaign Name is required and must be at least 8 characters long.');
                $('#campaignName').focus();
                return;
            }

            if (!location || location.length < 8) {
                alert('Location is required and must be at least 8 characters long.');
                $('#location').focus();
                return;
            }

            if (!location) {
                alert('Location is required and cannot be empty.');
                $('#location').focus();
                return;
            }
            
            if (!totalAmount || totalAmount < 1000) {
                alert('Fund Target is required and must be at least 1000.');
                $('#totalAmount').focus();
                return;
            }


            if (!endDate || selectedEndDate <= today) {
                alert('Expected End Date must be after today.');
                $('#endDate').focus();
                return;
            }

            if (!description || description.length < 8) {
                alert('Campaign Description is required and must be at least 8 characters long.');
                $('#description').focus();
                return;
            }


            endDate = formatDateToMMDDYYYY(endDate);
            console.log("EndDate" + endDate);


            
            const year = today.getFullYear();
            const month = String(today.getMonth() + 1).padStart(2, '0');
            const day = String(today.getDate()).padStart(2, '0');
            const hours = String(today.getHours()).padStart(2, '0');
            const minutes = String(today.getMinutes()).padStart(2, '0');
            const seconds = String(today.getSeconds()).padStart(2, '0');
            const dateTime = `${year}-${month}-${day}T${hours}:${minutes}:${seconds}`;

            console.log("CreatedDate" + dateTime);

            const formData = new FormData();
            formData.append('Title', campaignName);
            formData.append('Address', location);
            formData.append('ProjectId', projectId);
            formData.append('FundTarget', totalAmount);
            formData.append('EndDate', endDate);
            formData.append('Description', description);
            formData.append('CreateBy', userId);
            formData.append('IsActive', false);
            formData.append('DateOfCreation', dateTime);

            var logoFile = $('#projectImages')[0].files[0];
            if (logoFile) {
                formData.append('LogoFile', logoFile);
            }

            Array.from(files).forEach(file => {
                formData.append('FormFiles', file);
            });

            $.ajax({
                url: `${apiBaseUrl}/api/Campaign/CreateCampaignClient`,
                type: 'POST',
                headers: {
                    'Authorization': 'Bearer ' + jwtToken
                },
                data: formData,
                processData: false,
                contentType: false,
                success: function (response) {
                    alert(response.message || 'Campaign Request created successfully!');
                    window.location.href = '/Campaign/CampaignRequestManagement';
                },
                error: function (xhr, status, error) {
                    alert('Error: ' + xhr.responseText || status);
                }
            });
        });

    });
</script>