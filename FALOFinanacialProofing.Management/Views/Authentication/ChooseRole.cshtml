@model string
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <link rel="shortcut icon" href="~/favicon.png">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Select Role</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f4f4f4;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
        }

        .role-container {
            background-color: #ffffff;
            padding: 20px;
            border-radius: 10px;
            box-shadow: 0px 0px 15px rgba(0, 0, 0, 0.2);
            width: 300px;
            text-align: center;
        }

            .role-container h2 {
                margin-bottom: 20px;
                color: #333;
            }

        .role-list {
            list-style-type: none;
            padding: 0;
        }

        .role-item {
            padding: 10px;
            margin: 5px 0;
            background-color: #007bff;
            color: #ffffff;
            border-radius: 5px;
            cursor: pointer;
            transition: background-color 0.3s;
        }

            .role-item:hover {
                background-color: #0056b3;
            }
    </style>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jwt-decode@3.1.2/build/jwt-decode.min.js"></script>
</head>
<body>
    <div class="role-container">
        <h2>Choose Role</h2>
        <ul class="role-list" id="roleList">
        </ul>
    </div>


</body>
</html>
<script src="~/js/config.js"></script>
<script>
    var accessToken = '@Model';
    if (accessToken && accessToken.trim() !== '') {
        console.log('accessToken in Chooso Role:', accessToken);
        localStorage.setItem('jwtToken', accessToken);
    }
    $(document).ready(function () {
        const jwtToken = localStorage.getItem('jwtToken');
        console.log(jwtToken);
        if (!jwtToken) {
            alert('Bạn chưa đăng nhập!');
            window.location.href = '/Authentication/Login';
            return;
        }
        try {
            const decodedToken = jwt_decode(jwtToken);
            const userId = decodedToken.nameid;

            const roleId = decodedToken.RoleId;
            localStorage.setItem('userId', userId);
            const sub = decodedToken.sub
            localStorage.setItem('fullname', sub);

            let roles = decodedToken.role || [];
            let roleIds = decodedToken.RoleId || [];
            if (!Array.isArray(roles)) {
                roles = [roles];
            }

            if (!Array.isArray(roleIds)) {
                roleIds = [roleIds];
            }
            const roleList = $('#roleList');
            roles.forEach((role, index) => {
                const roleId = roleIds[index];
                const roleItem = $(`<li class="role-item">${role}</li>`);
                // khi click chạy vào hàm này
                roleItem.on('click', function () {
                    localStorage.setItem('loggingRole', role);
                    localStorage.setItem('loggingRoleId', roleId);
                    const checkrole = localStorage.getItem('loggingRole');
                    const checkRoleId = localStorage.getItem('loggingRoleId');
                    console.log('checkrole Selected:', checkrole);
                    console.log('Role ID selected:', checkRoleId);
                    window.location.href = `/Home/Index`;
                    // $.ajax({
                    //     url: `${apiBaseUrl}/api/Users/SetRoleLoginAfterLogin/${role}`,
                    //     type: 'GET',
                    //     contentType: 'application/json',
                    //     headers: {
                    //         'Authorization': `Bearer ${jwtToken}`
                    //     },
                    //     data: JSON.stringify({ userRole: role }),
                    //     success: function (response) {
                    //         console.log('Role được lưu thành công:', response);
                    //         window.location.href = `/Home/Index`;
                    //     },
                    //     error: function (xhr, status, error) {
                    //         console.error('Lỗi khi lưu role:', error);
                    //         alert('Có lỗi xảy ra khi lưu role. Vui lòng thử lại.');
                    //     }
                    // });
                });

                roleList.append(roleItem);
            });
        } catch (error) {
            console.error('Lỗi khi giải mã token:', error);
            alert('Token không hợp lệ. Vui lòng đăng nhập lại.');
            window.location.href = '/Authentication/Login';
        }
    });
</script>
