@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Chọn Vai Trò</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f4f4f4;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
        }

        .role-container {
            background-color: #ffffff;
            padding: 20px;
            border-radius: 10px;
            box-shadow: 0px 0px 15px rgba(0, 0, 0, 0.2);
            width: 300px;
            text-align: center;
        }

            .role-container h2 {
                margin-bottom: 20px;
                color: #333;
            }

        .role-list {
            list-style-type: none;
            padding: 0;
        }

        .role-item {
            padding: 10px;
            margin: 5px 0;
            background-color: #007bff;
            color: #ffffff;
            border-radius: 5px;
            cursor: pointer;
            transition: background-color 0.3s;
        }

            .role-item:hover {
                background-color: #0056b3;
            }
    </style>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jwt-decode@3.1.2/build/jwt-decode.min.js"></script>
</head>
<body>

    <div class="role-container">
        <h2>Chọn Vai Trò</h2>
        <ul class="role-list" id="roleList">
            
        </ul>
    </div>

    <script>
        $(document).ready(function() {
          const jwtToken = localStorage.getItem('jwtToken');
          console.log(jwtToken);
          if (!jwtToken) {
            alert('Bạn chưa đăng nhập!');
            window.location.href = '/login'; 
            return;
          }

          try {
            const decodedToken = jwt_decode(jwtToken);
            let roles = decodedToken.role || []; 
            
            if (!Array.isArray(roles)) {
              roles = [roles]; 
            }

            const roleList = $('#roleList');

            roles.forEach(role => {
              const roleItem = $(`<li class="role-item">${role}</li>`);
              console.log(role);
              roleItem.on('click', function() {
                localStorage.setItem('selectedRole', role);
                // window.location.href = `/home?role=${role}`; 
                window.location.href = `/Home/Index`; 
              });

              roleList.append(roleItem);
            });
          } catch (error) {
            console.error('Lỗi khi giải mã token:', error);
            alert('Token không hợp lệ. Vui lòng đăng nhập lại.');
            window.location.href = '/login';
          }
        });
    </script>

</body>
</html>
