
@{
    ViewData["Title"] = "AccountingBookProject";
}
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <link rel="stylesheet" type="text/css" href="https://fonts.googleapis.com/css?family=Roboto:300,400,500,700,900|Roboto+Slab:400,700" />
    <link href="../assets/css/nucleo-icons.css" rel="stylesheet" />
    <link href="../assets/css/nucleo-svg.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons+Round" rel="stylesheet">
    <link id="pagestyle" href="../assets/css/material-dashboard.css?v=3.1.0" rel="stylesheet" />
    <style>
        .modal {
            display: none;
            position: fixed;
            z-index: 1000;
            padding-top: 100px;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            overflow: auto;
            background-color: rgba(0, 0, 0, 0.4);
        }

        .modal-content {
            background-color: #fefefe;
            margin: auto;
            padding: 20px;
            border: 1px solid #888;
            width: 50%;
        }

        .close {
            color: #aaa;
            float: right;
            font-size: 28px;
            font-weight: bold;
        }

            .close:hover,
            .close:focus {
                color: black;
                text-decoration: none;
                cursor: pointer;
            }

        .form-control {
            margin-top: 10px;
            width: 100%;
            padding: 8px;
            border: 1px solid #ddd;
            border-radius: 4px;
        }

        .nav-tabs {
            display: flex;
            justify-content: space-around;
            margin-bottom: 20px;
            border-bottom: 2px solid #e0e0e0;
        }

            .nav-tabs a {
                padding: 10px 20px;
                text-decoration: none;
                color: #000;
                background-color: #f1f1f1;
                border-radius: 5px;
            }

                .nav-tabs a.active {
                    background-color: #EC407A;
                    color: #fff;
                }

                .nav-tabs a:hover {
                    background-color: #007bff;
                    color: #fff;
                }

        table {
            width: 100%;
            border-collapse: collapse;
        }


        th, td {
            padding: 10px;
            text-align: center;
        }

        td {
            vertical-align: middle;
            border-bottom: 1px solid #dee2e6;
        }

        .btn {
            margin: 5px;
            padding: 10px 20px;
            border: none;
            border-radius: 4px;
            cursor: pointer;
        }

        .search-filter-container {
            display: flex;
            justify-content: space-between;
            margin: 20px 0;
        }

        .search-box {
            width: 70%;
            padding: 10px;
            border-radius: 5px;
            border: 1px solid #ddd;
        }

        .filter-box {
            width: 25%;
            padding: 10px;
            border-radius: 5px;
            border: 1px solid #ddd;
        }
    </style>
</head>

<body>
    <div class="container-fluid py-4">
        <div class="row">
            <div class="col-12">
                <div class="card my-4">
                    <div class="card-header p-0 position-relative mt-n4 mx-3 z-index-2">
                        <div class="pt-4 pb-3 d-flex justify-content-between align-items-center">
                            <nav class="nav-tabs" id="navTabs">
                                <a asp-controller="Project" asp-action="ProjectDetail" >Project Detail</a>
                                <a asp-controller="Accounting" asp-action="AccountingBookProject" class="active">Accounting Book</a>

                            </nav>
                        </div>
                    </div>
                    <div class="card-header p-0 position-relative mt-n4 mx-3 z-index-2">
                        <div class="bg-gradient-primary shadow-primary border-radius-lg pt-4 pb-3 d-flex justify-content-between align-items-center">
                            <h6 class="text-white text-capitalize ps-3 mb-0">Accounting Book Project</h6>
                        </div>
                    </div>
                    <div class="search-filter-container px-3">
                        <input type="text" id="searchInput" placeholder="Search by Name" class="search-box" />
                    </div>
                    <div class="card-body px-0 pb-2">
                        <div class="table-responsive p-0">
                            <table class="table align-items-center mb-0">
                                <thead class="text-center">
                                    <tr>
                                        <th class="text-uppercase text-secondary text-xs font-weight-bolder opacity-7 text-center">STT</th>
                                        <th class="text-uppercase text-secondary text-xs font-weight-bolder opacity-7 text-center">File</th>                                    
                                        <th class="text-secondary text-secondary text-xs font-weight-bolder opacity-7 text-center">Action</th>
                                    </tr>
                                </thead>
                                <tbody id="voucherTableBody" class="text-center">
                                </tbody>
                            </table>
                        </div>
                    </div>

                </div>
                <div class="pagination-container text-center mt-4">
                    <div id="pagination"></div>
                </div>
            </div>
        </div>

        <div id="createVoucherModal" class="modal">
            <div class="modal-content">
                <span class="close" onclick="closeModal('createVoucherModal')">&times;</span>
                <h3>Upload Accounting Book</h3>
                <input type="date" id="voucherDateCreated" class="form-control" value="${new Date().toISOString().split('T')[0]}" hidden required />
                <label for="voucherFile">File:</label>
                <input type="file" id="voucherFile" class="form-control" />
                <span id="fileNameDisplay" style="margin-top: 10px;"></span>
                <button class="btn btn-success mt-3" onclick="submitVoucher()">Submit</button>
            </div>
        </div>

        <div id="detailModal" class="modal">
            <div class="modal-content">
                <span class="close" onclick="closeModal('detailModal')">&times;</span>
                <h3>Accounting Book Details</h3>
                <div id="voucherDetailContent"></div>
            </div>
        </div>
    </div>


</body>

</html>

<script src="../assets/js/core/popper.min.js"></script>
<script src="../assets/js/core/bootstrap.min.js"></script>
<script src="../assets/js/plugins/perfect-scrollbar.min.js"></script>
<script src="../assets/js/plugins/smooth-scrollbar.min.js"></script>
<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>

<script>
    const checkrole = localStorage.getItem('loggingRole');
    const projectId = localStorage.getItem('projectId');
    const navTabs = document.getElementById('navTabs');
    const userId = localStorage.getItem('userId');
    const jwtToken = localStorage.getItem('jwtToken');
    console.log(projectId);
    function showCreateVoucherPopup() {
        document.getElementById('createVoucherModal').style.display = 'block';
    }

    function submitVoucher() {
        const fileInput = document.getElementById('voucherFile');
        if (fileInput.files.length === 0) {
            alert("Please upload a file before submitting.");
            return;
        }

        const formData = new FormData();
        formData.append('File', fileInput.files[0]);
        formData.append('CurrentRole', checkrole);
        formData.append('UserId', userId);
        formData.append('CampaignId', campaignId);

        $.ajax({
            url: 'https://localhost:7294/api/AccountingBook/uploadaccountingbook',
            type: 'POST',
            headers: {
                'Authorization': `Bearer ${jwtToken}`
            },
            data: formData,
            processData: false,
            contentType: false,
            success: function (response) {
                alert(response.message);
                if (response.success) {
                    document.getElementById('voucherTableBody').insertAdjacentHTML('beforeend', createTableRow(response.Data));
                    closeModal('createVoucherModal');
                }
            },
            error: function (xhr, status, error) {
                alert('An error occurred while uploading the file. Please try again.');
                console.error('Error:', error);
            }
        });
    }

    let currentPage = 1;
    let searchInput = '';
    function fetchAccountingBooks() {
        $.ajax({
            url: `https://localhost:7294/api/AccountingBook/getallaccountingbookinproject?projectId=${projectId}&name=${searchInput}&page=${currentPage}`,
            type: 'GET',
            headers: {
                'Authorization': `Bearer ${jwtToken}`
            },
            success: function (response) {
                console.log('API Response:', response);
                if (response.success) {
                    console.log('Data:', response.data);
                    populateTable(response.data.data);
                    setupPagination(response.data.totalRecords, response.data.page);
                } else {
                    const tableBody = $('#voucherTableBody');
                    tableBody.empty();
                    tableBody.append('<tr><td colspan="3" class="text-center">No accounting books found</td></tr>');
                }
            },
            error: function (xhr, status, error) {
                alert('An error occurred while fetching the accounting books.');
                console.error('Error:', error);
            }
        });
    }

    function populateTable(data) {
        const tableBody = $('#voucherTableBody');
        tableBody.empty();

        data.forEach((accountingBook, index) => {
            const row = `
                <tr>
                    <td class="align-middle text-center">${index + 1}</td>
                    <td class="align-middle text-center">${accountingBook.filePath}</td>
                    <td class="align-middle text-center">
                        <button class="btn btn-success btn-sm" onclick="downloadFile(this, '${accountingBook.filePath}')">Download</button>
                    </td>
                </tr>
            `;
            tableBody.append(row);
        });
    }


    function downloadFile(button, fileName) {
        console.log(jwtToken);  
        $.ajax({
            url: `https://localhost:7294/api/AccountingBook/downloadaccountingbook/${fileName}`,
            type: 'GET',
            xhrFields: {
                responseType: 'blob' 
            },
            headers: {
                'Authorization': `Bearer ${jwtToken}`
            },
            success: function (data, status, xhr) {
                const downloadUrl = window.URL.createObjectURL(data); 
                const a = document.createElement('a');
                a.href = downloadUrl;
                a.download = fileName; 
                document.body.appendChild(a);
                a.click();
                document.body.removeChild(a);
                window.URL.revokeObjectURL(downloadUrl);
            },
            error: function (xhr, status, error) {
                if (xhr.status === 401) {
                    alert('Unauthorized: Please log in again.');
                } else {
                    alert('An error occurred while downloading the file.');
                    console.error('Error:', error);
                }
            }
        });
    }

    function closeModal(modalId) {
        document.getElementById(modalId).style.display = 'none';
    }

    window.onclick = function (event) {
        if (event.target == document.getElementById('createVoucherModal')) {
            closeModal('createVoucherModal');
        }
        if (event.target == document.getElementById('detailModal')) {
            closeModal('detailModal');
        }
    };
    function setupPagination(totalRecords, currentPage) {
        const totalPages = Math.ceil(totalRecords / 5);
        const paginationContainer = $('#pagination');
        paginationContainer.empty();

        for (let i = 1; i <= totalPages; i++) {
            const pageButton = `
                <button class="btn btn-sm btn-page ${i === currentPage ? 'btn-primary' : 'btn-light'}"
                        onclick="goToPage(${i})">${i}</button>
            `;
            paginationContainer.append(pageButton);
        }
    }

    function goToPage(page) {
        currentPage = page;
        fetchAccountingBooks();
    }

    $('#searchInput').on('keyup', function () {
        searchInput = $(this).val().trim();
        currentPage = 1; 
        fetchAccountingBooks();
    });

    fetchAccountingBooks();
</script>

<script async defer src="https://buttons.github.io/buttons.js"></script>
<script src="../assets/js/material-dashboard.min.js?v=3.1.0"></script>
