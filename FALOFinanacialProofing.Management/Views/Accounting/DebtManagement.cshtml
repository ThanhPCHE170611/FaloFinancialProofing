
@{
    ViewData["Title"] = "DebtManagement";
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <link rel="apple-touch-icon" sizes="76x76" href="../assets/img/apple-icon.png">
    <link rel="icon" type="image/png" href="../assets/img/favicon.png">
    <link rel="stylesheet" type="text/css" href="https://fonts.googleapis.com/css?family=Roboto:300,400,500,700,900|Roboto+Slab:400,700" />
    <link href="../assets/css/nucleo-icons.css" rel="stylesheet" />
    <link href="../assets/css/nucleo-svg.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons+Round" rel="stylesheet">
    <link id="pagestyle" href="../assets/css/material-dashboard.css?v=3.1.0" rel="stylesheet" />
    <style>
        .nav-tabs {
            display: flex;
            justify-content: space-around;
            margin-bottom: 20px;
            border-bottom: 2px solid #e0e0e0;
        }

            .nav-tabs a {
                padding: 10px 20px;
                text-decoration: none;
                color: #000;
                background-color: #f1f1f1;
                border-radius: 5px;
            }

                .nav-tabs a.active {
                    background-color: #EC407A;
                    color: #fff;
                }

                .nav-tabs a:hover {
                    background-color: #007bff;
                    color: #fff;
                }

        .search-filter-container {
            display: flex;
            justify-content: space-between;
            margin: 20px 0;
        }

        .search-box {
            width: 70%;
            padding: 10px;
            border-radius: 5px;
            border: 1px solid #ddd;
        }

        .filter-box {
            width: 25%;
            padding: 10px;
            border-radius: 5px;
            border: 1px solid #ddd;
        }
    </style>
</head>

<body>
    <div class="container-fluid py-4">
        <div class="row">
            <div class="col-12">
                <div class="card my-4">
                    <div class="card-header p-0 position-relative mt-n4 mx-3 z-index-2">
                        <div class="pt-4 pb-3 d-flex justify-content-between align-items-center">
                            <nav class="nav-tabs" id="navTabs">
                                <a asp-controller="Campaign" asp-action="CampaignDetail_PMB" >Campaign Detail</a>
                                <a asp-controller="Accounting" asp-action="AccountingBookCampaign_PMB">Accounting Book</a>
                                <a asp-controller="Campaign" asp-action="Member_PMB">Member</a>
                                <a asp-controller="Accounting" asp-action="DebtManagement" class="active">Debt</a>
                            </nav>
                        </div>
                    </div>  
                    <div class="card-header p-0 position-relative mt-n4 mx-3 z-index-2">
                        <div class="bg-gradient-primary shadow-primary border-radius-lg pt-4 pb-3 d-flex justify-content-between align-items-center">
                            <h6 class="text-white text-capitalize ps-3 mb-0">Debt Management</h6>
                        </div>
                    </div>
                    <div class="search-filter-container px-3">
                        <input type="text" id="searchInput" placeholder="Search by email" class="search-box" />
                        <select id="statusFilter" class="filter-box">
                            <option value="">All Statuses</option>
                            <option value="true">Active</option>
                            <option value="false">Inactive</option>
                        </select>
                    </div>
                    <div class="card-body px-0 pb-2">
                        <div class="table-responsive p-0">
                            <table class="table align-items-center mb-0">
                                <thead>
                                    <tr>
                                        <th class="text-center text-uppercase text-secondary text-xxs font-weight-bolder opacity-7">STT</th>
                                        <th class="text-center text-uppercase text-secondary text-xxs font-weight-bolder opacity-7">Name</th>
                                        <th class="text-center text-uppercase text-secondary text-xxs font-weight-bolder opacity-7">Role</th>
                                        <th class="text-center text-uppercase text-secondary text-xxs font-weight-bolder opacity-7">Email</th>
                                        <th class="text-center text-uppercase text-secondary text-xxs font-weight-bolder opacity-7">Debt</th>
                                        <th class="text-center text-uppercase text-secondary text-xxs font-weight-bolder opacity-7">Status</th>
                                    </tr>
                                </thead>
                                <tbody id="debtTable">
                                    <tr>
                                        <td class="align-middle text-center">
                                            1
                                        </td>
                                        <td class="align-middle text-center">
                                            <div class="d-flex px-2 py-1">
                                                <div class="d-flex flex-column justify-content-center">
                                                    <h6 class="mb-0 text-sm">John Michael</h6>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="align-middle text-center">
                                            <span class="text-secondary text-xs font-weight-bold">Project Manager</span>
                                        </td>
                                        <td class="align-middle text-center">
                                            <span class="text-secondary text-xs font-weight-bold">pm@gmail.com</span>
                                        </td>
                                        <td class="align-middle text-center">
                                            <span class="text-secondary text-xs font-weight-bold">1000</span>
                                        </td>
                                        <td class="align-middle text-center">
                                            <span class="badge badge-sm bg-gradient-success">Active</span>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="pagination-container text-center mt-4">
                    <div id="pagination"></div>
                </div>
            </div>
        </div>
    </div>

</body>

</html>

<script src="../assets/js/core/popper.min.js"></script>
<script src="../assets/js/core/bootstrap.min.js"></script>
<script src="../assets/js/plugins/perfect-scrollbar.min.js"></script>
<script src="../assets/js/plugins/smooth-scrollbar.min.js"></script>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    var win = navigator.platform.indexOf('Win') > -1;
    if (win && document.querySelector('#sidenav-scrollbar')) {
      var options = {
        damping: '0.5'
      }
      Scrollbar.init(document.querySelector('#sidenav-scrollbar'), options);
    }
    $(document).ready(function () {
        const jwtToken = localStorage.getItem('jwtToken');
        const userId = localStorage.getItem('userId');
        const checkrole = localStorage.getItem('loggingRole');
        const campaignId = localStorage.getItem('campaignId');
        if (!jwtToken) {
            window.location.href = '/Authentication/Login';
            return;
        }
        const apiUrl = `${apiBaseUrl}/api/DebManagement/getdebtlistforpmb`;

        function fetchData(emailFilter = "", isActive = "", page = 1) {
            const requestData = {
                userId: userId,
                currentLoggingRole: checkrole,
                campaignId: campaignId,
                emailFilter: emailFilter,
                isActive: isActive,
                page: page
            };

            $.ajax({
                url: apiUrl,
                type: 'GET',
                headers: {
                    'Authorization': `Bearer ${jwtToken}`
                },
                data: requestData,
                success: function (response) {
                    if (response.success) {
                        updateTable(response.data.data);
                        updatePagination(response.data.totalRecords, page);
                    } else {
                        alert(response.message || "Failed to retrieve data.");
                    }
                },
                error: function (error) {
                    console.error("Error fetching data:", error);
                    alert("An error occurred while fetching data.");
                }
            });
        }

        function updateTable(data) {
            const tableBody = $("#debtTable");
            tableBody.empty();

            if (data.length === 0) {
                tableBody.append('<tr><td colspan="6" class="text-center">No records found</td></tr>');
                return;
            }

            data.forEach((item, index) => {
                const row = `
                    <tr>
                        <td class="align-middle text-center">${index + 1}</td>
                        <td class="align-middle text-center">${item.userName || "N/A"}</td>
                        <td class="align-middle text-center">${item.userRole || "N/A"}</td>
                        <td class="align-middle text-center">${item.userEmail || "N/A"}</td>
                        <td class="align-middle text-center">${item.debt.toLocaleString() || 0}</td>
                        <td class="align-middle text-center">
                            <span class="badge badge-sm bg-gradient-${item.isActive ? 'success' : 'danger'}">
                                ${item.isActive ? 'Active' : 'Inactive'}
                            </span>
                        </td>
                    </tr>
                `;
                tableBody.append(row);
            });
        }

        function updatePagination(totalRecords, currentPage) {
            const paginationContainer = $("#pagination");
            paginationContainer.empty();

            const pageSize = 50; 
            const totalPages = Math.ceil(totalRecords / pageSize);

            for (let i = 1; i <= totalPages; i++) {
                const pageButton = `<button class="btn btn-sm ${i === currentPage ? 'btn-primary' : 'btn-secondary'}" data-page="${i}">${i}</button>`;
                paginationContainer.append(pageButton);
            }

            $("#pagination button").on('click', function () {
                const page = $(this).data('page');
                const emailFilter = $("#searchInput").val();
                const isActive = $("#statusFilter").val();
                fetchData(emailFilter, isActive, page);
            });
        }

        $("#searchInput").on('input', function () {
            const emailFilter = $(this).val();
            const isActive = $("#statusFilter").val();
            fetchData(emailFilter, isActive, 1);
        });

        $("#statusFilter").on('change', function () {
            const emailFilter = $("#searchInput").val();
            const isActive = $(this).val();
            fetchData(emailFilter, isActive, 1);
        });

        fetchData();
    });
</script>

    
