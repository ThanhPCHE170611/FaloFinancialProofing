
@{
    ViewData["Title"] = "OrganizationCreate";
}
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <link rel="stylesheet" type="text/css" href="https://fonts.googleapis.com/css?family=Roboto:300,400,500,700,900|Roboto+Slab:400,700" />
    <link href="../assets/css/nucleo-icons.css" rel="stylesheet" />
    <link href="../assets/css/nucleo-svg.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons+Round" rel="stylesheet">
    <link id="pagestyle" href="../assets/css/material-dashboard.css?v=3.1.0" rel="stylesheet" />
    <style>
        .form-control {
            border: 1px solid #ced4da;
            border-radius: 0.25rem;
        }

        #save-btn {
            display: flex;
            justify-content: center;
            margin-top: 20px;
        }

        #logoPreview img {
            width: 100px;
            height: 100px;
            border-radius: 50%;
        }

        #fileList {
            margin-top: 10px;
            display: flex;
            flex-wrap: wrap;
            gap: 5px;
        }

            #fileList li {
                padding: 5px 10px;
                background-color: #e0e0e0;
                border-radius: 5px;
                list-style: none;
            }
    </style>
</head>

<body>
    <div class="container-fluid py-4">
        <div class="row">
            <div class="col-12">
                <div class="card my-4">
                    <div class="card-header p-0 position-relative mt-n4 mx-3 z-index-2">
                        <div class="bg-gradient-primary shadow-primary border-radius-lg pt-4 pb-3 d-flex justify-content-between align-items-center">
                            <h6 class="text-white text-capitalize ps-3 mb-0">Create Organization</h6>
                        </div>
                    </div>
                    <div class="card-body">

                        <div class="mb-3">
                            <label for="organizationLogo" class="form-label">Logo</label>
                            <input type="file" class="form-control" id="organizationLogo" accept="image/*" onchange="previewLogo()">
                            <div id="logoPreview" class="mt-3"></div>
                        </div>

                        <div class="mb-3">
                            <label for="name" class="form-label">Name</label>
                            <input type="text" class="form-control" id="name" placeholder="Enter Organization Name">
                        </div>

                        <div class="mb-3">
                            <label for="mainOffice" class="form-label">Main Office</label>
                            <input type="text" class="form-control" id="mainOffice" placeholder="Enter Main Office">
                        </div>

                        <div class="mb-3">
                            <label for="representative" class="form-label">Representative</label>
                            <input type="text" class="form-control" id="representative" placeholder="Enter Representative's Name">
                        </div>

                        <div class="mb-3">
                            <label for="phoneNumber" class="form-label">Phone Number</label>
                            <input type="text" class="form-control" id="phoneNumber" placeholder="Enter Phone Number">
                        </div>

                        <div class="mb-3">
                            <label for="email" class="form-label">Email</label>
                            <input type="email" class="form-control" id="email" placeholder="Enter Email">
                        </div>

                        <div class="mb-3">
                            <label for="description" class="form-label">Description</label>
                            <textarea class="form-control" id="description" rows="3" placeholder="Enter Description"></textarea>
                        </div>

                        <div class="mb-3">
                            <label for="vision" class="form-label">Vision</label>
                            <textarea class="form-control" id="vision" rows="3" placeholder="Enter Vision"></textarea>
                        </div>

                        <div class="mb-3">
                            <label for="mission" class="form-label">Mission</label>
                            <textarea class="form-control" id="mission" rows="3" placeholder="Enter Mission"></textarea>
                        </div>

                        <div class="mb-3">
                            <label for="coreValue" class="form-label">Core Value</label>
                            <textarea class="form-control" id="coreValue" rows="3" placeholder="Enter Core Value"></textarea>
                        </div>

                        <div class="mb-3">
                            <label for="mainActivity" class="form-label">Main Activity</label>
                            <textarea class="form-control" id="mainActivity" rows="3" placeholder="Enter Main Activity"></textarea>
                        </div>

                        <div class="mb-3">
                            <label for="interests" class="form-label">Interests</label>
                            <input type="text" class="form-control" id="interests" placeholder="Enter Interests">
                        </div>

                        <div class="mb-3">
                            <label for="volunteerExperience" class="form-label">Volunteer Experience</label>
                            <textarea class="form-control" id="volunteerExperience" rows="3" placeholder="Enter Volunteer Experience"></textarea>
                        </div>

                        <div class="mb-3">
                            <label for="volunteerObjectives" class="form-label">Volunteer Objectives</label>
                            <textarea class="form-control" id="volunteerObjectives" rows="3" placeholder="Enter Volunteer Objectives"></textarea>
                        </div>

                        <div class="mb-3">
                            <label for="bio" class="form-label">Bio</label>
                            <textarea class="form-control" id="bio" rows="3" placeholder="Enter Bio"></textarea>
                        </div>

                        <div id="save-btn">
                            <button type="submit" class="btn btn-warning">Create Organization</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>


</body>

</html>
<script src="../assets/js/core/popper.min.js"></script>
<script src="../assets/js/core/bootstrap.min.js"></script>
<script src="../assets/js/plugins/perfect-scrollbar.min.js"></script>
<script src="../assets/js/plugins/smooth-scrollbar.min.js"></script>
<script async defer src="https://buttons.github.io/buttons.js"></script>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
    const jwtToken = localStorage.getItem('jwtToken');
    // if (!jwtToken) {
    //     window.location.href = '/Authentication/Login';
    //     return;
    // }
    function previewLogo() {
        const file = document.getElementById('organizationLogo').files[0];
        const preview = document.getElementById('logoPreview');
        preview.innerHTML = '';
        if (file) {
            const reader = new FileReader();
            reader.onload = function (e) {
                const img = document.createElement('img');
                img.src = e.target.result;
                preview.appendChild(img);
            };
            reader.readAsDataURL(file);
        }
    }
    $('#save-btn button').on('click', function () {
        const userId = localStorage.getItem('userId');

        if (!jwtToken || !userId) {
            alert('JWT token or User ID is missing. Please log in again.');
            return;
        }
        const requiredFields = [
        { id: '#name', label: 'Name' },
        { id: '#mainOffice', label: 'Main Office' },
        { id: '#representative', label: 'Representative' },
        { id: '#phoneNumber', label: 'Phone Number' },
        { id: '#email', label: 'Email' },
        { id: '#description', label: 'Description' },
        { id: '#vision', label: 'Vision' },
        { id: '#mission', label: 'Mission' },
        { id: '#coreValue', label: 'Core Value' },
        { id: '#mainActivity', label: 'Main Activity' },
        { id: '#interests', label: 'Interests' },
        { id: '#volunteerExperience', label: 'Volunteer Experience' },
        { id: '#volunteerObjectives', label: 'Volunteer Objectives' },
        { id: '#bio', label: 'Bio' }
    ];

    for (const field of requiredFields) {
        const value = $(field.id).val().trim();
        if (!value || value.length < 8) {
            alert(`${field.label} is required and must be at least 8 characters long.`);
            $(field.id).focus();
            return;
        }
    }

    const phoneNumber = $('#phoneNumber').val().trim();
    const phoneRegex = /^[0-9]{10,15}$/; 
    if (!phoneRegex.test(phoneNumber)) {
        alert('Phone Number must be between 10 and 15 digits.');
        $('#phoneNumber').focus();
        return;
    }

        const formData = new FormData();
        formData.append('UserId', userId);
        formData.append('Name', $('#name').val());
        formData.append('Main_office', $('#mainOffice').val());
        formData.append('Representative', $('#representative').val());
        formData.append('PhoneNumber', $('#phoneNumber').val());
        formData.append('Email', $('#email').val());
        formData.append('Description', $('#description').val());
        formData.append('Vision', $('#vision').val());
        formData.append('Mission', $('#mission').val());
        formData.append('CoreValue', $('#coreValue').val());
        formData.append('MainActivity', $('#mainActivity').val());
        formData.append('Interests', $('#interests').val());
        formData.append('VolunteerExperience', $('#volunteerExperience').val());
        formData.append('VolunteerObjectives', $('#volunteerObjectives').val());
        formData.append('Bio', $('#bio').val());

        const logoFile = $('#organizationLogo')[0].files[0];
        if (logoFile) {
            formData.append('LogoFile', logoFile);
        }

        $.ajax({
            url: `${apiBaseUrl}/api/Organizations/CreateOrganization`,
            type: 'POST',
            data: formData,
            contentType: false,
            processData: false,
            headers: {
                'Authorization': `Bearer ${jwtToken}`
            },
            success: function (response) {
                if (response.success) {
                    alert('Organization created successfully!');
                    console.log('Organization creation response:', response);
                    window.location.href = `/Organization/OrganizationManagement`;
                } else {
                    alert(response.message);
                }
            },
            error: function (errors) {
                if (errors.responseJSON && errors.responseJSON.errors) {
                    console.error('Detailed Validation Errors:');
                    for (const [field, messages] of Object.entries(errors.responseJSON.errors)) {
                        console.group(`Field: ${field}`);
                        messages.forEach(message => console.error(`Error: ${message}`));
                        console.groupEnd();
                    }
                    alert('Validation errors occurred. Check console for details.');
                } else {
                    console.error('Unexpected error:', errors);
                    alert('An unexpected error occurred. Check console for details.');
                }
            }
        });
    });
</script>