@{
    ViewData["Title"] = "PrepayCreate";
}
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <link rel="apple-touch-icon" sizes="76x76" href="../assets/img/apple-icon.png">
    <link rel="icon" type="image/png" href="../assets/img/favicon.png">
    <link rel="stylesheet" type="text/css" href="https://fonts.googleapis.com/css?family=Roboto:300,400,500,700,900|Roboto+Slab:400,700" />
    <link href="../assets/css/nucleo-icons.css" rel="stylesheet" />
    <link href="../assets/css/nucleo-svg.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons+Round" rel="stylesheet">
    <link id="pagestyle" href="../assets/css/material-dashboard.css?v=3.1.0" rel="stylesheet" />
    <style>
        .form-control {
            border: 1px solid #ced4da;
            border-radius: 0.25rem;
        }

        #save-btn {
            display: flex;
            justify-content: center;
            margin-top: 20px;
        }

        #fileList {
            margin-top: 10px;
            display: flex;
            flex-wrap: wrap;
            gap: 5px;
        }

            #fileList li {
                padding: 5px 10px;
                background-color: #e0e0e0;
                border-radius: 5px;
                list-style: none;
            }

        #voucherList {
            margin-top: 10px;
            display: flex;
            flex-wrap: wrap;
            gap: 5px;
        }

            #voucherList li {
                padding: 5px 10px;
                background-color: #e0e0e0;
                border-radius: 5px;
                list-style: none;
            }

        .nav-tabs {
            display: flex;
            justify-content: space-around;
            margin-bottom: 20px;
            border-bottom: 2px solid #e0e0e0;
        }

            .nav-tabs a {
                padding: 10px 20px;
                text-decoration: none;
                color: #000;
                background-color: #f1f1f1;
                border-radius: 5px;
            }

                .nav-tabs a.active {
                    background-color: #EC407A;
                    color: #fff;
                }

                .nav-tabs a:hover {
                    background-color: #007bff;
                    color: #fff;
                }

        .searchable-select {
            width: 100%;
            padding: 10px;
            border-radius: 5px;
            border: 1px solid #ced4da;
        }

    </style>
</head>

<body>
    <div class="container-fluid py-4">
        <div class="row">
            <div class="col-12">
                <div class="card my-4">
                    <div class="card-header p-0 position-relative mt-n4 mx-3 z-index-2">
                        <div class="pt-4 pb-3 d-flex justify-content-between align-items-center">
                            <nav class="nav-tabs" id="navTabs">
                                <a asp-controller="Campaign" asp-action="CampaignDetail">Campaign Detail</a>
                                <a asp-controller="Prepay" asp-action="PrepayManagement">Prepay Request</a>
                                <a asp-controller="Payment" asp-action="PaymentManagement">Payment Request</a>
                                <a asp-controller="Accounting" asp-action="AccountingBookCampaign">Accounting Book</a>
                                <a asp-controller="Campaign" asp-action="Member">Member</a>
                                <a asp-controller="Prepay" asp-action="PrepayManagement_PM" class="active">Prepay Created Request</a>
                                <a asp-controller="Payment" asp-action="PaymentManagement_PM">Payment Created Request</a>
                            </nav>
                        </div>
                    </div>
                    <div class="card-header p-0 position-relative mt-n4 mx-3 z-index-2">
                        <div class="bg-gradient-primary shadow-primary border-radius-lg pt-4 pb-3 d-flex justify-content-between align-items-center">
                            <h6 class="text-white text-capitalize ps-3 mb-0">Create Prepay Request</h6>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="mb-3" hidden>
                            <label for="title" class="form-label">Created Date</label>
                            <p class="form-control" id="todaytime" readonly></p>
                        </div>
                        <div class="mb-3">
                            <label for="expectedMoney" class="form-label">Expected Money</label>
                            <input type="number" class="form-control" id="expectedMoney" placeholder="Enter expected money" min="1000" step="100000">
                        </div>

                        <div class="mb-3">
                            <label for="assignFrom" class="form-label">Assign From</label>
                            <select id="assignFrom" class="searchable-select form-control">
                            </select>
                        </div>

                        <div class="mb-3">
                            <label for="description" class="form-label">Description</label>
                            <textarea class="form-control" id="description" rows="3" placeholder="Enter description"></textarea>
                        </div>

                        <div class="mb-3">
                            <label for="attachments" class="form-label">Attachments</label>
                            <input type="file" class="form-control" id="attachments" multiple>
                            <ul id="fileList">
                            </ul>
                        </div>
                        <div class="mb-3" id="voucherInput" style="display: none;">
                            <label for="vouchers" class="form-label">Vouchers</label>
                            <input type="file" class="form-control" id="vouchers" multiple>
                            <ul id="voucherList"></ul>
                        </div>
                    </div>

                    <div id="save-btn">
                        <button class="btn btn-warning btn-lg" id="create-btn" style="margin-left:10px">Create</button>
                        <div>
                            <a asp-controller="Prepay" asp-action="PrepayManagement_PM" class="btn btn-success btn-lg" style="margin-left:10px">Cancel</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>


</body>

</html>
<script src="../assets/js/core/popper.min.js"></script>
<script src="../assets/js/core/bootstrap.min.js"></script>
<script src="../assets/js/plugins/perfect-scrollbar.min.js"></script>
<script src="../assets/js/plugins/smooth-scrollbar.min.js"></script>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="~/js/prepay/prepaycreate_pm.js"></script>