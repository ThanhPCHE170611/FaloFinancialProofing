    <style>
        .form-control {
            border: 1px solid #ced4da;
            border-radius: 0.25rem;
        }

        #save-btn {
            display: flex;
            justify-content: center;
            margin-top: 20px;
        }

        #imagePreview img {
            width: 100%;
            height: auto;
        }

        #fileList {
            margin-top: 10px;
            display: flex;
            flex-wrap: wrap;
            gap: 5px;
        }

            #fileList li {
                padding: 5px 10px;
                background-color: #e0e0e0;
                border-radius: 5px;
                list-style: none;
            }

        .nav-tabs {
            display: flex;
            justify-content: space-around;
            margin-bottom: 20px;
            border-bottom: 2px solid #e0e0e0;
        }

            .nav-tabs a {
                padding: 10px 20px;
                text-decoration: none;
                color: #000;
                background-color: #f1f1f1;
                border-radius: 5px;
            }

                .nav-tabs a.active {
                    background-color: #EC407A;
                    color: #fff;
                }

                .nav-tabs a:hover {
                    background-color: #007bff;
                    color: #fff;
                }
    </style>
</head>
<body>
    <div class="container-fluid py-4">
        <div class="row">
            <div class="col-12">
                <div class="card my-4">
                    <div class="card-header p-0 position-relative mt-n4 mx-3 z-index-2">
                        <div class=" pt-4 pb-3 d-flex justify-content-between align-items-center">
                            <nav class="nav-tabs" id="navTabs">
                                <a asp-controller="Project" asp-action="ProjectDetail" class="active">Project Detail</a>
                                <a asp-controller="Accounting" asp-action="AccountingBookProject">Accounting Book</a>
                            </nav>
                        </div>
                    </div>
                    <div class="card-header p-0 position-relative mt-n4 mx-3 z-index-2">
                        <div class="bg-gradient-primary shadow-primary border-radius-lg pt-4 pb-3 d-flex justify-content-between align-items-center">
                            <h6 class="text-white text-capitalize ps-3 mb-0">Project Detail</h6>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="row mb-3">
                            <div class="col-md-12">
                                <label for="projectName" class="form-label">Project Name</label>
                                <input type="text" class="form-control" id="projectName" readonly >
                            </div>
                        </div>


                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label for="constructionInfo" class="form-label">Created By</label>
                                <input type="text" class="form-control" id="constructionInfo" readonly>
                            </div>
                            <div class="col-md-6">
                                <label for="start-date" class="form-label">Start Time</label>
                                <input type="date" class="form-control" id="unit" readonly>
                            </div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label for="projectProcess" class="form-label">Project Process</label>
                                <select class="form-select" id="projectProcess" disabled>
                                    <option value="Running">Running</option>
                                    <option value="Close">Close</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label for="projectStatus" class="form-label">Project Status</label>
                                <select class="form-select" id="projectStatus" disabled>
                                    <option value="true">Active</option>
                                    <option value="false">Inactive</option>
                                </select>
                            </div>
                        </div>


                        <div class="mb-3">
                            <label for="context" class="form-label">Project Description</label>
                            <div id="editor-container" style="height: 200px;" ></div>
                        </div>
                    </div>
                </div>

                @* <div class="card mb-4"> *@
                @*     <div class="card-header"> *@
                @*         <h5>File Include</h5> *@
                @*     </div> *@
                @*     <div class="card-body"> *@
                @*         <button class="btn btn-primary mb-3" onclick="document.getElementById('relatedDocs').click()" disabled>Choose file</button> *@
                @*         <input type="file" id="relatedDocs" class="form-control d-none" accept=".xls,.xlsx" multiple> *@
                @*         <ul id="docList" class="list-group mt-3"></ul> *@
                @*     </div> *@
                @* </div> *@
                <div class="card mb-4">
                    <div class="card-header">
                        <h5>Project Files</h5>
                    </div>
                    <div class="card-body">
                        <ul id="campaignFilesList" class="list-unstyled"></ul>
                    </div>
                </div>

                <div class="card mb-4">
                    <div class="card-header">
                        <h5>Project Picture</h5>
                    </div>
                    <div class="card-body">
                        <button id="choseImage" class="btn btn-primary mb-3" onclick="document.getElementById('projectImages').click()" disabled>Choose file</button>
                        <input type="file" id="projectImages" class="form-control d-none" accept="image/*" multiple>
                        <div id="imagePreview" class="mt-3 row"></div>
                    </div>
                </div>
                <div id="save-btn">
                    @* <button class="btn btn-primary btn-lg" style="margin-left:10px">Save</button> *@
                    <div>
                        <a href="/Project/ProjectManagement" class="btn btn-success btn-lg" style="margin-right:10px">Cancel</a>
                    </div>
                </div>
            </div>
        </div>
    </div>

</body>
</html>

