@page "/login"
@using FALOFinancialProofing.Client.Models
@layout LayoutLogin
@inject IJSRuntime JSRuntime

@code {
    private async Task HandleLogin()
    {
        var username = await JSRuntime.InvokeAsync<string>("eval", "$('#email').val()");
        var password = await JSRuntime.InvokeAsync<string>("eval", "$('#password').val()");

        // Call the login JavaScript function
        var response = await JSRuntime.InvokeAsync<ApiResponse>("login", username, password);

        // Handle the response
        if (response.Success)
        {
            await JSRuntime.InvokeVoidAsync("eval", "$('#message').text('Login successful: ' + response.Message);");
            // Optionally, handle token storage or redirection here
        }
        else
        {
            await JSRuntime.InvokeVoidAsync("eval", "$('#message').text('Error: ' + response.Message);");
        }
    }
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login Page</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            background-color: #f8f9fa;
            .login-card

        {
            border-radius: 15px;
        }
    </style>
</head>
<body>
    <div class="container d-flex justify-content-center align-items-center vh-100">
        <div class="card login-card p-4 shadow-lg" style="width: 25rem;">
            <h3 class="text-center mb-4">Login</h3>
            <form>
                <div class="mb-3">
                    <label for="email" class="form-label">Email address</label>
                    <input type="email" class="form-control" id="email" placeholder="Enter your email" required>
                </div>
                <div class="mb-3">
                    <label for="password" class="form-label">Password</label>
                    <input type="password" class="form-control" id="password" placeholder="Enter your password" required>
                </div>
                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary" @onclick="HandleLogin">Login</button>
                    </div>
                @* <NavLink href="campaignmanagement">
                </NavLink> *@
                <div class="text-center mt-3">
                    <hr>
                    <button type="button" class="btn btn-danger btn-block" onclick="alert('Login with Google')">
                        <i class="fab fa-google"></i> Login with Google
                    </button>
                </div>
                <div class="text-center mt-3">
                    <NavLink href="/register" class="btn btn-link">Don't have an account? Sign up</NavLink>
                </div>
                <div class="text-center mt-3">
                    <a href="forgotpassword">Forgot password?</a>
                </div>
            </form>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://kit.fontawesome.com/a076d05399.js" crossorigin="anonymous"></script>
</body>
</html>
