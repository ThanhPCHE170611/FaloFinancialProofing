	<link rel="icon" href="~/client/favicon.png" type="image/icon type">
	<link href="~/client/css/normalize.css" rel="stylesheet" />
	<link href="~/client/icomoon/icomoon.css" rel="stylesheet" />
	<link href="~/client/css/vendor.css" rel="stylesheet" />
	<link href="~/client/css/style.css" rel="stylesheet" />
	<link rel="stylesheet" href="~/client/css/site.css" asp-append-version="true" />

