<body data-bs-spy="scroll" data-bs-target="#header" tabindex="0">
	<div id="header-wrap">
		<header id="header">
			<div class="container-fluid">
				<div class="row">

					<div class="col-md-2">
						<div class="main-logo">
							<a class="navbar-brand" asp-area="" asp-page="/HomePage/Homepage" style="font-size:xx-large; font-family:'Times New Roman', Times, serif">@* <img alt="logo" src="~/images/All seeing monarch.png" style="height: 70px; length: 70px" />   *@Falo Financial Proofing</a>

						</div>

					</div>

					<div class="col-md-10 p-2">
						<nav id="navbar">
							<div class="main-menu stellarnav">
								<ul class="menu-list">
									<li class="menu-item active"><a asp-page="/HomePage/Homepage">Giới thiệu</a></li>
									<li class="menu-item"><a asp-page="/OCR/DetectOCR" class="nav-link">Chiến dịch</a></li>
									<li class="menu-item"><a asp-area="" asp-page="/Novels/Create" class="nav-link">Sự kiện</a></li>
									<li class="menu-item"><a class="nav-link text-warning-emphasis" asp-area="" asp-page="/Logout">Logout</a></li>
								</ul>

								<div class="hamburger">
									<span class="bar"></span>
									<span class="bar"></span>
									<span class="bar"></span>
								</div>

							</div>
						</nav>

					</div>

				</div>
			</div>
		</header>
	</div><!--header-wrap-->
	@Body

	<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.1/dist/js/bootstrap.bundle.min.js"
			integrity="sha384-HwwvtgBNo3bZJJLYd8oVXjrBZt8cqVSpeBNS5n7C8IVInixGAoxmnlMuBnhbgrkm"
			crossorigin="anonymous"></script>

	<script src="~/client/js/jquery-1.11.0.min.js"></script>
	<script src="~/client/js/plugins.js"></script>
	<script src="~/client/js/script.js"></script>
	@* <script src="~/lib/jquery/dist/jquery.min.js"></script> *@
	<script src="~/client/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
	<script src="~/client/js/site.js" asp-append-version="true"></script>

